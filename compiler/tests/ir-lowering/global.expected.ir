module "global" {
  symbol bump: function () -> U16
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  symbol counter: dataglobal U16
    attributes: { banked: false, cloaked: false }
    flags: { escapes: true }
  function bump(%0: Mem) -> (U16, Mem) {
    bb_entry:
      preds: -
      %1:Ptr(U16, unbanked) = AddrOf @counter
      %2:U16, %3 = Load %1, %0
      %4:U8 = Const #1:U8
      %5:U16 = ZExt %4
      %6:U16 = Add %2, %5
      %7:Ptr(U16, unbanked) = AddrOf @counter
      %8 = Store %7, %6, %3
      %9:Ptr(U16, unbanked) = AddrOf @counter
      %10:U16, %11 = Load %9, %8
      Return %10, %11
  }
}
