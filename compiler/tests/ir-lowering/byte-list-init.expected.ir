module "byte-list-init" {
  symbol bl: function () -> U16
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  symbol three: function () -> F32
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  function bl(%0: Mem) -> (U16, Mem) {
    bb_entry:
      preds: -
      %1:U32 = Const #305419896:U32
      %2:U16 = Trunc %1
      Return %2, %0
  }
  function three(%0: Mem) -> (F32, Mem) {
    bb_entry:
      preds: -
      %1:F32 = Const #fp4008000000000000:F32
      Return %1, %0
  }
}
