module "class-inherit" {
  layout 0: size=2 align=1 fields=[(0:Ptr(Void, unbanked))]
  layout 1: size=3 align=1 fields=[(0:Ptr(Void, unbanked)), (2:U8)]
  layout 2: size=0 align=1
  layout 3: size=6 align=1 fields=[(0:Ptr(Void, unbanked)), (2:Ptr(Void, unbanked)), (4:Ptr(Void, unbanked))]
  layout 4: size=4 align=1 fields=[(0:Ptr(Void, unbanked)), (2:U8), (3:U8)]
  layout 5: size=6 align=1 fields=[(0:Ptr(Void, unbanked)), (2:Ptr(Void, unbanked)), (4:Ptr(Void, unbanked))]
  symbol Animal$vtbl: vtable [_, _, Animal$speak]
    attributes: { banked: false, cloaked: false }
  symbol Animal$speak: function (Ptr(Agg(1), unbanked)) -> U8
    attributes: { banked: false, cloaked: false, static: false, variadic: false }
  symbol Dog$vtbl: vtable [Animal$vtbl, _, Dog$speak]
    attributes: { banked: false, cloaked: false }
  symbol Dog$speak: function (Ptr(Agg(4), unbanked)) -> U8
    attributes: { banked: false, cloaked: false, static: false, variadic: false }
  symbol run: function () -> U8
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  symbol _xtc_alloc: runtime () -> Void
    attributes: { banked: false, cloaked: false, variadic: false }
  function Animal$speak(%0: Ptr(Agg(1), unbanked), %1: Mem) -> (U8, Mem) {
    bb_entry:
      preds: -
      %2:U8 = Const #1:U8
      Return %2, %1
  }
  function Dog$speak(%0: Ptr(Agg(4), unbanked), %1: Mem) -> (U8, Mem) {
    bb_entry:
      preds: -
      %2 = Retain %0, %1
      %3:U8 = Const #2:U8
      %4 = Release %0, %2
      Return %3, %4
  }
  function run(%0: Mem) -> (U8, Mem) {
    bb_entry:
      preds: -
      %1:U16 = Const #1:U16
      %2:U16 = Const #4:U16
      %3:U16 = Const #0:U16
      %4:Ptr(Void, unbanked) = IntToPtr %3
      %5:Ptr(Agg(4), unbanked), %6 = Call @_xtc_alloc, [%1, %2, %4], CallConv::Standard, %0
      %7:Ptr(Ptr(Void, unbanked), xt_data) = FieldAddr %5, #0:U8
      %8:Ptr(Void, unbanked) = AddrOf @Dog$vtbl
      %9 = Store %7, %8, %6
      %10:U8, %11 = VTblDispatch %5, #2:U16, %9
      %12 = Release %5, %11
      Return %10, %12
  }
}
