module "compound-assign" {
  symbol run: function (U16) -> U16
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  function run(%0: U16, %1: Mem) -> (U16, Mem) {
    bb_entry:
      preds: -
      %2:U8 = Const #5:U8
      %3:U16 = ZExt %2
      %4:U16 = Add %0, %3
      %5:U8 = Const #2:U8
      %6:U16 = ZExt %5
      %7:U16 = Mul %4, %6
      %8:U8 = Const #1:U8
      %9:U16 = ZExt %8
      %10:U16 = Sub %7, %9
      %11:U8 = Const #255:U8
      %12:U16 = ZExt %11
      %13:U16 = And %10, %12
      %14:U8 = Const #1:U8
      %15:U16 = Shl %13, %14
      Return %15, %1
  }
}
