module "zp-callersave" {
  symbol addOne: function (U8) -> U8
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  symbol applyD: function (U8) -> U8
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  symbol run: function () -> U8
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  function addOne(%0: U8, %1: Mem) -> (U8, Mem) {
    bb_entry:
      preds: -
      %2:U8 = Const #1:U8
      %3:U8 = Add %0, %2
      Return %3, %1
  }
  function applyD(%0: U8, %1: Mem) -> (U8, Mem) {
    bb_entry:
      preds: -
      %2:U8, %3 = Call @addOne, [%0], CallConv::Standard, %1
      Return %2, %3
  }
  function run(%0: Mem) -> (U8, Mem) {
    bb_entry:
      preds: -
      %1:U8 = Const #5:U8
      %2:U8, %3 = Call @addOne, [%1], CallConv::Standard, %0
      %4:U8 = Const #7:U8
      %5:U8, %6 = Call @addOne, [%4], CallConv::Standard, %3
      %7:U8 = Const #100:U8
      %8:U8, %9 = Call @applyD, [%7], CallConv::Standard, %6
      %10:U8 = Add %2, %5
      %11:U8 = Add %10, %8
      Return %11, %9
  }
}
