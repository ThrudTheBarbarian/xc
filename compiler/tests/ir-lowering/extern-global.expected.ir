module "extern-global" {
  symbol readOutside: function () -> U16
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  symbol gOutside: dataglobal U16
    attributes: { banked: false, cloaked: false, extern: true }
    flags: { escapes: true }
  function readOutside(%0: Mem) -> (U16, Mem) {
    bb_entry:
      preds: -
      %1:Ptr(U16, unbanked) = AddrOf @gOutside
      %2:U16, %3 = Load %1, %0
      Return %2, %3
  }
}
