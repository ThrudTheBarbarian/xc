module "self-method-call" {
  layout 0: size=2 align=1 fields=[(0:Ptr(Void, unbanked))]
  layout 1: size=4 align=1 fields=[(0:Ptr(Void, unbanked)), (2:U16)]
  layout 2: size=0 align=1
  layout 3: size=6 align=1 fields=[(0:Ptr(Void, unbanked)), (2:Ptr(Void, unbanked)), (4:Ptr(Void, unbanked))]
  symbol Counter$init: function (Ptr(Agg(1), unbanked)) -> Void
    attributes: { banked: false, cloaked: false, static: false, variadic: false }
  symbol Counter$_bump: function (Ptr(Agg(1), unbanked)) -> Void
    attributes: { banked: false, cloaked: false, static: false, variadic: false }
  symbol Counter$run: function (Ptr(Agg(1), unbanked)) -> U16
    attributes: { banked: false, cloaked: false, static: false, variadic: false }
  symbol count3: function () -> U16
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  symbol _xtc_alloc: runtime () -> Void
    attributes: { banked: false, cloaked: false, variadic: false }
  function Counter$init(%0: Ptr(Agg(1), unbanked), %1: Mem) -> Mem {
    bb_entry:
      preds: -
      %2:U8 = Const #0:U8
      %3:U16 = ZExt %2
      %4:Ptr(U16, unbanked) = FieldAddr %0, #1:U8
      %5 = Store %4, %3, %1
      Return %5
  }
  function Counter$_bump(%0: Ptr(Agg(1), unbanked), %1: Mem) -> Mem {
    bb_entry:
      preds: -
      %2:Ptr(U16, unbanked) = FieldAddr %0, #1:U8
      %3:U16, %4 = Load %2, %1
      %5:U8 = Const #1:U8
      %6:U16 = ZExt %5
      %7:U16 = Add %3, %6
      %8:Ptr(U16, unbanked) = FieldAddr %0, #1:U8
      %9 = Store %8, %7, %4
      Return %9
  }
  function Counter$run(%0: Ptr(Agg(1), unbanked), %1: Mem) -> (U16, Mem) {
    bb_entry:
      preds: -
      %2 = Retain %0, %1
      %3 = Call @Counter$_bump, [%0], CallConv::Standard, %2
      %4 = Call @Counter$_bump, [%0], CallConv::Standard, %3
      %5 = Call @Counter$_bump, [%0], CallConv::Standard, %4
      %6:Ptr(U16, unbanked) = FieldAddr %0, #1:U8
      %7:U16, %8 = Load %6, %5
      %9 = Release %0, %8
      Return %7, %9
  }
  function count3(%0: Mem) -> (U16, Mem) {
    bb_entry:
      preds: -
      %1:U16 = Const #1:U16
      %2:U16 = Const #4:U16
      %3:U16 = Const #0:U16
      %4:Ptr(Void, unbanked) = IntToPtr %3
      %5:Ptr(Agg(1), unbanked), %6 = Call @_xtc_alloc, [%1, %2, %4], CallConv::Standard, %0
      %7:Ptr(U16, unbanked) = Bitcast %5
      %8:U16 = Const #1:U16
      %9 = Store %7, %8, %6
      %10 = Call @Counter$init, [%5], CallConv::Standard, %9
      %11:U16, %12 = Call @Counter$run, [%5], CallConv::Standard, %10
      %13 = Release %5, %12
      Return %11, %13
  }
}
