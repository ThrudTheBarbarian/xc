module "addrof-member" {
  layout 0: size=4 align=1 fields=[(0:U16), (2:U16)]
  symbol offset: function () -> U16
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  function offset(%0: Mem) -> (U16, Mem) {
    frame: { pinned: [(%1:Agg(0) @0 esc)], size: 4 }
    bb_entry:
      preds: -
      %2:Ptr(Agg(0), unbanked) = AddrOf %1
      %3:U8 = Const #11:U8
      %4:U16 = ZExt %3
      %5:Ptr(U16, unbanked) = FieldAddr %2, #0:U8
      %6 = Store %5, %4, %0
      %7:Ptr(Agg(0), unbanked) = AddrOf %1
      %8:U8 = Const #22:U8
      %9:U16 = ZExt %8
      %10:Ptr(U16, unbanked) = FieldAddr %7, #1:U8
      %11 = Store %10, %9, %6
      %12:Ptr(Agg(0), unbanked) = AddrOf %1
      %13:Ptr(U16, unbanked) = FieldAddr %12, #0:U8
      %14:Ptr(Agg(0), unbanked) = AddrOf %1
      %15:Ptr(U16, unbanked) = FieldAddr %14, #1:U8
      %16:U16 = PtrToInt %15
      %17:U16 = PtrToInt %13
      %18:U16 = Sub %16, %17
      Return %18, %11
  }
}
