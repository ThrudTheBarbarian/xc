module "addrof-member" {
  layout 0: size=4 align=1 fields=[(0:U16), (2:U16)]
  symbol offset: function () -> U16
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  function offset(%0: Mem) -> (U16, Mem) {
    frame: { pinned: [(%1:Agg(0) @0 esc)], size: 4 }
    bb_entry:
      preds: -
      %2:Ptr(Agg(0), unbanked) = AddrOf %1
      %3:Ptr(U16, unbanked) = FieldAddr %2, #0:U8
      %4:U16 = Const #0:U16
      %5 = Store %3, %4, %0
      %6:Ptr(U16, unbanked) = FieldAddr %2, #1:U8
      %7:U16 = Const #0:U16
      %8 = Store %6, %7, %5
      %9:Ptr(Agg(0), unbanked) = AddrOf %1
      %10:U8 = Const #11:U8
      %11:U16 = ZExt %10
      %12:Ptr(U16, unbanked) = FieldAddr %9, #0:U8
      %13 = Store %12, %11, %8
      %14:Ptr(Agg(0), unbanked) = AddrOf %1
      %15:U8 = Const #22:U8
      %16:U16 = ZExt %15
      %17:Ptr(U16, unbanked) = FieldAddr %14, #1:U8
      %18 = Store %17, %16, %13
      %19:Ptr(Agg(0), unbanked) = AddrOf %1
      %20:Ptr(U16, unbanked) = FieldAddr %19, #0:U8
      %21:Ptr(Agg(0), unbanked) = AddrOf %1
      %22:Ptr(U16, unbanked) = FieldAddr %21, #1:U8
      %23:U16 = PtrToInt %22
      %24:U16 = PtrToInt %20
      %25:U16 = Sub %23, %24
      Return %25, %18
  }
}
