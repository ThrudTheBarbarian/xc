module "operator-bracket" {
  layout 0: size=2 align=1 fields=[(0:Ptr(Void, unbanked))]
  layout 1: size=3 align=1 fields=[(0:Ptr(Void, unbanked)), (2:U8)]
  layout 2: size=0 align=1
  layout 3: size=6 align=1 fields=[(0:Ptr(Void, unbanked)), (2:Ptr(Void, unbanked)), (4:Ptr(Void, unbanked))]
  symbol V$size: function (Ptr(Agg(1), unbanked)) -> U8
    attributes: { banked: false, cloaked: false, static: false, variadic: false }
  symbol V$norm: function (Ptr(Agg(1), unbanked)) -> Ptr(Agg(1), unbanked)
    attributes: { banked: false, cloaked: false, static: false, variadic: false }
  symbol V$same: function (Ptr(Agg(1), unbanked)) -> Ptr(Agg(1), unbanked)
    attributes: { banked: false, cloaked: false, static: false, variadic: false }
  symbol V$low: function (Ptr(Agg(1), unbanked)) -> U8
    attributes: { banked: false, cloaked: false, static: true, variadic: false }
  symbol run: function (Ptr(Agg(1), unbanked), U8, U8) -> U8
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  symbol __sdata_V: dataglobal Agg(1)
    attributes: { banked: false, cloaked: false }
    flags: { escapes: true }
  function V$size(%0: Ptr(Agg(1), unbanked), %1: Mem) -> (U8, Mem) {
    bb_entry:
      preds: -
      %2 = Retain %0, %1
      %3:Ptr(U8, unbanked) = FieldAddr %0, #1:U8
      %4:U8, %5 = Load %3, %2
      %6 = Release %0, %5
      Return %4, %6
  }
  function V$norm(%0: Ptr(Agg(1), unbanked), %1: Mem) -> (Ptr(Agg(1), unbanked), Mem) {
    bb_entry:
      preds: -
      %2 = Retain %0, %1
      %3 = Retain %0, %2
      %4 = Release %0, %3
      Return %0, %4
  }
  function V$same(%0: Ptr(Agg(1), unbanked), %1: Mem) -> (Ptr(Agg(1), unbanked), Mem) {
    bb_entry:
      preds: -
      %2 = Retain %0, %1
      %3 = Retain %0, %2
      %4 = Release %0, %3
      Return %0, %4
  }
  function V$low(%0: Ptr(Agg(1), unbanked), %1: Mem) -> (U8, Mem) {
    bb_entry:
      preds: -
      %2:Ptr(Agg(1), unbanked) = AddrOf @__sdata_V
      %3:Ptr(U8, unbanked) = FieldAddr %0, #1:U8
      %4:U8, %5 = Load %3, %1
      Return %4, %5
  }
  function run(%0: Ptr(Agg(1), unbanked), %1: U8, %2: U8, %3: Mem) -> (U8, Mem) {
    bb_entry:
      preds: -
      %4:U8, %5 = Call @V$size, [%0], CallConv::Standard, %3
      %6:Ptr(Agg(1), unbanked), %7 = Call @V$norm, [%0], CallConv::Standard, %5
      %8:U8, %9 = Call @V$size, [%6], CallConv::Standard, %7
      %10:U8 = Add %4, %8
      %11:Ptr(Agg(1), unbanked), %12 = Call @V$same, [%0], CallConv::Standard, %9
      %13:U8, %14 = Call @V$low, [%11], CallConv::Standard, %12
      %15:U8 = Add %10, %13
      %16:U8 = Or %1, %2
      %17:U8 = Add %15, %16
      %18 = Release %6, %14
      %19 = Release %11, %18
      Return %17, %19
  }
}
