module "unary-ops" {
  symbol un: function () -> U16
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  function un(%0: Mem) -> (U16, Mem) {
    bb_entry:
      preds: -
      %1:U8 = Const #0:U8
      %2:U16 = ZExt %1
      %3:U8 = Const #0:U8
      %4:U16 = ZExt %3
      Branch bb_1_for_header
    bb_1_for_header:
      preds: bb_entry, bb_1_for_body
      %5:U16 = Phi [(bb_entry, %4), (bb_1_for_body, %12)]
      %6:U16 = Phi [(bb_entry, %2), (bb_1_for_body, %10)]
      %7:U8 = Const #10:U8
      %8:U16 = ZExt %7
      %9:Bool = ICmp ULT, %5, %8
      CondBranch %9, bb_1_for_body, bb_1_for_exit
    bb_1_for_body:
      preds: bb_1_for_header
      %10:U16 = Add %6, %5
      %11:U16 = Const #1:U16
      %12:U16 = Add %5, %11
      Branch bb_1_for_header
    bb_1_for_exit:
      preds: bb_1_for_header
      %13:U8 = Const #0:U8
      %14:U16 = ZExt %13
      %15:U16 = Const #0:U16
      %16:Bool = ICmp EQ, %14, %15
      CondBranch %16, bb_4_then, bb_4_join
    bb_4_then:
      preds: bb_1_for_exit
      %17:U8 = Const #3:U8
      %18:U16 = ZExt %17
      %19:U16 = Sub %6, %18
      Branch bb_4_join
    bb_4_join:
      preds: bb_1_for_exit, bb_4_then
      %20:U16 = Phi [(bb_1_for_exit, %6), (bb_4_then, %19)]
      %21:U16 = Const #1:U16
      %22:U16 = Sub %20, %21
      %23:U16 = Const #1:U16
      %24:U16 = Add %22, %23
      Return %24, %0
  }
}
