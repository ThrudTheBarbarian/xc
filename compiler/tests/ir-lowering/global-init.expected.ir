module "global-init" {
  symbol read_gw: function () -> U16
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  symbol gW: dataglobal U16 init [#$34, #$12]
    attributes: { banked: false, cloaked: false }
    flags: { escapes: true }
  symbol gI: dataglobal I16 init [#$9C, #$FF]
    attributes: { banked: false, cloaked: false }
    flags: { escapes: true }
  symbol gExpr: dataglobal U32 init [#$A0, #$86, #$01, #$00]
    attributes: { banked: false, cloaked: false }
    flags: { escapes: true }
  function read_gw(%0: Mem) -> (U16, Mem) {
    bb_entry:
      preds: -
      %1:Ptr(U16, unbanked) = AddrOf @gW
      %2:U16, %3 = Load %1, %0
      Return %2, %3
  }
}
