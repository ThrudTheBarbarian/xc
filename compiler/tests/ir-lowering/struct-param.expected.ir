module "struct-param" {
  layout 0: size=4 align=1 fields=[(0:U16), (2:U16)]
  symbol sumpt: function (Agg(0)) -> U16
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  symbol sp: function () -> U16
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  function sumpt(%0: Agg(0), %1: Mem) -> (U16, Mem) {
    bb_entry:
      preds: -
      %2:Ptr(Agg(0), unbanked) = AddrOf %0
      %3:Ptr(U16, unbanked) = FieldAddr %2, #0:U8
      %4:U16, %5 = Load %3, %1
      %6:Ptr(Agg(0), unbanked) = AddrOf %0
      %7:Ptr(U16, unbanked) = FieldAddr %6, #1:U8
      %8:U16, %9 = Load %7, %5
      %10:U16 = Add %4, %8
      Return %10, %9
  }
  function sp(%0: Mem) -> (U16, Mem) {
    frame: { pinned: [(%1:Agg(0) @0)], size: 4 }
    bb_entry:
      preds: -
      %2:Ptr(Agg(0), unbanked) = AddrOf %1
      %3:U8 = Const #40:U8
      %4:U16 = ZExt %3
      %5:Ptr(U16, unbanked) = FieldAddr %2, #0:U8
      %6 = Store %5, %4, %0
      %7:Ptr(Agg(0), unbanked) = AddrOf %1
      %8:U8 = Const #2:U8
      %9:U16 = ZExt %8
      %10:Ptr(U16, unbanked) = FieldAddr %7, #1:U8
      %11 = Store %10, %9, %6
      %12:Ptr(Agg(0), unbanked) = AddrOf %1
      %13:Agg(0), %14 = Load %12, %11
      %15:U16, %16 = Call @sumpt, [%13], CallConv::Standard, %14
      Return %15, %16
  }
}
