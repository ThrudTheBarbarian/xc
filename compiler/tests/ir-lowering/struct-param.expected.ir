module "struct-param" {
  layout 0: size=4 align=1 fields=[(0:U16), (2:U16)]
  symbol sumpt: function (Agg(0)) -> U16
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  symbol sp: function () -> U16
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  function sumpt(%0: Agg(0), %1: Mem) -> (U16, Mem) {
    bb_entry:
      preds: -
      %2:Ptr(Agg(0), unbanked) = AddrOf %0
      %3:Ptr(U16, unbanked) = FieldAddr %2, #0:U8
      %4:U16, %5 = Load %3, %1
      %6:Ptr(Agg(0), unbanked) = AddrOf %0
      %7:Ptr(U16, unbanked) = FieldAddr %6, #1:U8
      %8:U16, %9 = Load %7, %5
      %10:U16 = Add %4, %8
      Return %10, %9
  }
  function sp(%0: Mem) -> (U16, Mem) {
    frame: { pinned: [(%1:Agg(0) @0)], size: 4 }
    bb_entry:
      preds: -
      %2:Ptr(Agg(0), unbanked) = AddrOf %1
      %3:Ptr(U16, unbanked) = FieldAddr %2, #0:U8
      %4:U16 = Const #0:U16
      %5 = Store %3, %4, %0
      %6:Ptr(U16, unbanked) = FieldAddr %2, #1:U8
      %7:U16 = Const #0:U16
      %8 = Store %6, %7, %5
      %9:Ptr(Agg(0), unbanked) = AddrOf %1
      %10:U8 = Const #40:U8
      %11:U16 = ZExt %10
      %12:Ptr(U16, unbanked) = FieldAddr %9, #0:U8
      %13 = Store %12, %11, %8
      %14:Ptr(Agg(0), unbanked) = AddrOf %1
      %15:U8 = Const #2:U8
      %16:U16 = ZExt %15
      %17:Ptr(U16, unbanked) = FieldAddr %14, #1:U8
      %18 = Store %17, %16, %13
      %19:Ptr(Agg(0), unbanked) = AddrOf %1
      %20:Agg(0), %21 = Load %19, %18
      %22:U16, %23 = Call @sumpt, [%20], CallConv::Standard, %21
      Return %22, %23
  }
}
