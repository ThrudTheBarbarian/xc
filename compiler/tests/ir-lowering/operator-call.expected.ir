module "operator-call" {
  layout 0: size=2 align=1 fields=[(0:Ptr(Void, unbanked))]
  layout 1: size=3 align=1 fields=[(0:Ptr(Void, unbanked)), (2:U8)]
  layout 2: size=0 align=1
  layout 3: size=4 align=1 fields=[(0:Ptr(Void, unbanked)), (2:Ptr(Void, unbanked))]
  symbol V$plus: function (Ptr(Agg(1), unbanked), Ptr(Agg(1), unbanked)) -> Ptr(Agg(1), unbanked)
    attributes: { banked: false, cloaked: false, static: false, variadic: false }
  symbol V$neg: function (Ptr(Agg(1), unbanked)) -> Ptr(Agg(1), unbanked)
    attributes: { banked: false, cloaked: false, static: false, variadic: false }
  symbol V$scaled: function (U8, Ptr(Agg(1), unbanked)) -> Ptr(Agg(1), unbanked)
    attributes: { banked: false, cloaked: false, static: true, variadic: false }
  symbol run: function (Ptr(Agg(1), unbanked), Ptr(Agg(1), unbanked)) -> U8
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  symbol __sdata_V: dataglobal Agg(1)
    attributes: { banked: false, cloaked: false }
    flags: { escapes: true }
  function V$plus(%0: Ptr(Agg(1), unbanked), %1: Ptr(Agg(1), unbanked), %2: Mem) -> (Ptr(Agg(1), unbanked), Mem) {
    bb_entry:
      preds: -
      %3 = Retain %0, %2
      %4 = Retain %1, %3
      %5 = Release %0, %4
      Return %1, %5
  }
  function V$neg(%0: Ptr(Agg(1), unbanked), %1: Mem) -> (Ptr(Agg(1), unbanked), Mem) {
    bb_entry:
      preds: -
      %2 = Retain %0, %1
      %3 = Retain %0, %2
      %4 = Release %0, %3
      Return %0, %4
  }
  function V$scaled(%0: U8, %1: Ptr(Agg(1), unbanked), %2: Mem) -> (Ptr(Agg(1), unbanked), Mem) {
    bb_entry:
      preds: -
      %3:Ptr(Agg(1), unbanked) = AddrOf @__sdata_V
      %4 = Retain %1, %2
      Return %1, %4
  }
  function run(%0: Ptr(Agg(1), unbanked), %1: Ptr(Agg(1), unbanked), %2: Mem) -> (U8, Mem) {
    bb_entry:
      preds: -
      %3:Ptr(Agg(1), unbanked), %4 = Call @V$plus, [%0, %1], CallConv::Standard, %2
      %5:Ptr(Agg(1), unbanked), %6 = Call @V$neg, [%0], CallConv::Standard, %4
      %7:U8 = Const #2:U8
      %8:Ptr(Agg(1), unbanked), %9 = Call @V$scaled, [%7, %0], CallConv::Standard, %6
      %10:Ptr(U8, unbanked) = FieldAddr %3, #1:U8
      %11:U8, %12 = Load %10, %9
      %13:Ptr(U8, unbanked) = FieldAddr %5, #1:U8
      %14:U8, %15 = Load %13, %12
      %16:U8 = Add %11, %14
      %17:Ptr(U8, unbanked) = FieldAddr %8, #1:U8
      %18:U8, %19 = Load %17, %15
      %20:U8 = Add %16, %18
      %21 = Release %8, %19
      %22 = Release %5, %21
      %23 = Release %3, %22
      Return %20, %23
  }
}
