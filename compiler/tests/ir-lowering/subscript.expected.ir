module "subscript" {
  symbol readAt: function (Ptr(U8, unbanked), U8) -> U8
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  symbol writeAt: function (Ptr(U8, unbanked), U8, U8) -> Void
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  symbol bumpReturnOld: function (Ptr(U8, unbanked), U8) -> U8
    attributes: { banked: false, cabi: false, cloaked: false, variadic: false }
  function readAt(%0: Ptr(U8, unbanked), %1: U8, %2: Mem) -> (U8, Mem) {
    bb_entry:
      preds: -
      %3:U16 = ZExt %1
      %4:Ptr(U8, unbanked) = ElementAddr %0, %3
      %5:U8, %6 = Load %4, %2
      Return %5, %6
  }
  function writeAt(%0: Ptr(U8, unbanked), %1: U8, %2: U8, %3: Mem) -> Mem {
    bb_entry:
      preds: -
      %4:U16 = ZExt %1
      %5:Ptr(U8, unbanked) = ElementAddr %0, %4
      %6 = Store %5, %2, %3
      Return %6
  }
  function bumpReturnOld(%0: Ptr(U8, unbanked), %1: U8, %2: Mem) -> (U8, Mem) {
    bb_entry:
      preds: -
      %3:U16 = ZExt %1
      %4:Ptr(U8, unbanked) = ElementAddr %0, %3
      %5:U8, %6 = Load %4, %2
      %7:U8 = Const #1:U8
      %8:U8 = Add %5, %7
      %9 = Store %4, %8, %6
      Return %5, %9
  }
}
