; STACK-ABI §3 reference fixture — comfortable case.
; pinnedLocalSize = 100 bytes, two u8 params (K = 2). Total N + K =
; 102, well below 119. Highest param byte offset = +N+8+K = 100+8+2
; = +110, fits in signed-8-bit.

module "large-frame-ok" {
  symbol roomy: function (U8, U8) -> U8
    attributes: { banked: false, cloaked: false, variadic: false }

  function roomy(%a: U8, %b: U8, %m0: Mem) -> (U8, Mem) {
    ; 100 single-byte u8 slots. The verifier's §12.11 check requires
    ; sum-of-byte-widths == declared size; 100 * 1 = 100. ✓
    frame: { pinned: [
      (%l00:U8 @0), (%l01:U8 @1), (%l02:U8 @2), (%l03:U8 @3),
      (%l04:U8 @4), (%l05:U8 @5), (%l06:U8 @6), (%l07:U8 @7),
      (%l08:U8 @8), (%l09:U8 @9), (%l10:U8 @10), (%l11:U8 @11),
      (%l12:U8 @12), (%l13:U8 @13), (%l14:U8 @14), (%l15:U8 @15),
      (%l16:U8 @16), (%l17:U8 @17), (%l18:U8 @18), (%l19:U8 @19),
      (%l20:U8 @20), (%l21:U8 @21), (%l22:U8 @22), (%l23:U8 @23),
      (%l24:U8 @24), (%l25:U8 @25), (%l26:U8 @26), (%l27:U8 @27),
      (%l28:U8 @28), (%l29:U8 @29), (%l30:U8 @30), (%l31:U8 @31),
      (%l32:U8 @32), (%l33:U8 @33), (%l34:U8 @34), (%l35:U8 @35),
      (%l36:U8 @36), (%l37:U8 @37), (%l38:U8 @38), (%l39:U8 @39),
      (%l40:U8 @40), (%l41:U8 @41), (%l42:U8 @42), (%l43:U8 @43),
      (%l44:U8 @44), (%l45:U8 @45), (%l46:U8 @46), (%l47:U8 @47),
      (%l48:U8 @48), (%l49:U8 @49), (%l50:U8 @50), (%l51:U8 @51),
      (%l52:U8 @52), (%l53:U8 @53), (%l54:U8 @54), (%l55:U8 @55),
      (%l56:U8 @56), (%l57:U8 @57), (%l58:U8 @58), (%l59:U8 @59),
      (%l60:U8 @60), (%l61:U8 @61), (%l62:U8 @62), (%l63:U8 @63),
      (%l64:U8 @64), (%l65:U8 @65), (%l66:U8 @66), (%l67:U8 @67),
      (%l68:U8 @68), (%l69:U8 @69), (%l70:U8 @70), (%l71:U8 @71),
      (%l72:U8 @72), (%l73:U8 @73), (%l74:U8 @74), (%l75:U8 @75),
      (%l76:U8 @76), (%l77:U8 @77), (%l78:U8 @78), (%l79:U8 @79),
      (%l80:U8 @80), (%l81:U8 @81), (%l82:U8 @82), (%l83:U8 @83),
      (%l84:U8 @84), (%l85:U8 @85), (%l86:U8 @86), (%l87:U8 @87),
      (%l88:U8 @88), (%l89:U8 @89), (%l90:U8 @90), (%l91:U8 @91),
      (%l92:U8 @92), (%l93:U8 @93), (%l94:U8 @94), (%l95:U8 @95),
      (%l96:U8 @96), (%l97:U8 @97), (%l98:U8 @98), (%l99:U8 @99)
    ], size: 100 }
    bb_entry:
      preds: -
      Return %a, %m0
  }
}
