; STACK-ABI §3 reference fixture — JUST OUTSIDE the budget.
; pinnedLocalSize = 118 bytes, two u8 params (K = 2). Total N + K =
; 120, which exceeds the 119-byte budget by exactly one byte.
; Highest param byte at +N+8+K = 118+8+2 = +128 — past the
; signed-8-bit limit of +127 by one. **Not encodable** on the
; xt CPU with a single PSH/PLL pair; the 6502 backend must
; refuse to compile this (or emit chained PSH/PLL once that
; capability lands; see STACK-ABI.md §7).
;
; The optional --paranoid verifier invariant from STACK-ABI.md §4
; targets this exact shape.
;
; Locals: 29 u32 (116 bytes) + 2 u8 (2 bytes) = 118 bytes total.

module "large-frame-overflow" {
  symbol overflow: function (U8, U8) -> U8
    attributes: { banked: false, cloaked: false, variadic: false }

  function overflow(%a: U8, %b: U8, %m0: Mem) -> (U8, Mem) {
    frame: { pinned: [
      (%u00:U32 @0),   (%u01:U32 @4),   (%u02:U32 @8),   (%u03:U32 @12),
      (%u04:U32 @16),  (%u05:U32 @20),  (%u06:U32 @24),  (%u07:U32 @28),
      (%u08:U32 @32),  (%u09:U32 @36),  (%u10:U32 @40),  (%u11:U32 @44),
      (%u12:U32 @48),  (%u13:U32 @52),  (%u14:U32 @56),  (%u15:U32 @60),
      (%u16:U32 @64),  (%u17:U32 @68),  (%u18:U32 @72),  (%u19:U32 @76),
      (%u20:U32 @80),  (%u21:U32 @84),  (%u22:U32 @88),  (%u23:U32 @92),
      (%u24:U32 @96),  (%u25:U32 @100), (%u26:U32 @104), (%u27:U32 @108),
      (%u28:U32 @112),
      (%pad0:U8 @116), (%pad1:U8 @117)
    ], size: 118 }
    bb_entry:
      preds: -
      Return %a, %m0
  }
}
