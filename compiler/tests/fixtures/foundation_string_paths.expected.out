/usr/lib/libc.a        abs=1 n=4 [/|usr|lib|libc.a] norm="/usr/lib/libc.a" rejoin="/usr/lib/libc.a" last="libc.a" ext="a"
/usr//lib/             abs=1 n=3 [/|usr|lib] norm="/usr/lib" rejoin="/usr/lib" last="lib" ext=""
a/b/../c/./d.txt       abs=0 n=6 [a|b|..|c|.|d.txt] norm="a/c/d.txt" rejoin="a/b/../c/./d.txt" last="d.txt" ext="txt"
../../x                abs=0 n=3 [..|..|x] norm="../../x" rejoin="../../x" last="x" ext=""
a/..                   abs=0 n=2 [a|..] norm="" rejoin="a/.." last=".." ext=""
a/../..                abs=0 n=3 [a|..|..] norm=".." rejoin="a/../.." last=".." ext=""
/..                    abs=1 n=2 [/|..] norm="/" rejoin="/.." last=".." ext=""
/a/../../b             abs=1 n=5 [/|a|..|..|b] norm="/b" rejoin="/a/../../b" last="b" ext=""
./                     abs=0 n=1 [.] norm="" rejoin="." last="." ext=""
/                      abs=1 n=1 [/] norm="/" rejoin="/" last="/" ext=""
                       abs=0 n=0 [] norm="" rejoin="" last="" ext=""
.bashrc                abs=0 n=1 [.bashrc] norm=".bashrc" rejoin=".bashrc" last=".bashrc" ext=""
