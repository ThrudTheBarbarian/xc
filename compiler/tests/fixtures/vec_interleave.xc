// vec_interleave.xc — a big reduction body run as two interleaved copies.
// A body over the vectoriser's big-body size (MD5's rounds) that reduces into
// one sum is unrolled twice with the copies' instructions interleaved, each
// clone next to its original, so the core works on two independent chains;
// on arm64 a function with no float scalars has 22 vector registers for it
// (v8-v15 too, their low halves saved), and the copies go ahead only if a
// pressure estimate says they fit. Here: an MD5-shaped body with four
// counter-derived words live through it; the same body in a function that also
// uses a float (14 registers: the copies may not fit and must then not be
// made); and a par block, whose run function starts each tile at its own lo,
// so the vector limit is `((hi - lo) & ~3) + lo`. Trip counts are odd, so the
// remainder runs too. Every sum must equal the -O0 build's.
#import "Stdio.xc"
#import "Par.xc"

u32 rounds(u32 lo, u32 n)
{
    u32 total = (u32)0;
    for (u32 i in lo..n)
        {
            u32 m0 = i;
            u32 m1 = i * (u32)3;
            u32 m2 = i ^ (u32)0x5bd1e995;
            u32 m3 = i + (u32)7;
            u32 a = (u32)0x67452301;
            u32 b = (u32)0xefcdab89;
            u32 c = (u32)0x98badcfe;
            u32 d = (u32)0x10325476;
            { u32 t = a + ((b & c) | (~b & d)) + m0 + (u32)1999951809; a = d; d = c; c = b; b = b + ((t << (u32)7) | (t >> (u32)25)); }
            { u32 t = a + ((b & c) | (~b & d)) + m1 + (u32)2522798642; a = d; d = c; c = b; b = b + ((t << (u32)12) | (t >> (u32)20)); }
            { u32 t = a + ((b & c) | (~b & d)) + m2 + (u32)2198630850; a = d; d = c; c = b; b = b + ((t << (u32)17) | (t >> (u32)15)); }
            { u32 t = a + ((b & c) | (~b & d)) + m3 + (u32)3405809747; a = d; d = c; c = b; b = b + ((t << (u32)22) | (t >> (u32)10)); }
            { u32 t = a + ((b & c) | (~b & d)) + m0 + (u32)404257171; a = d; d = c; c = b; b = b + ((t << (u32)5) | (t >> (u32)27)); }
            { u32 t = a + ((b & c) | (~b & d)) + m1 + (u32)1303098497; a = d; d = c; c = b; b = b + ((t << (u32)9) | (t >> (u32)23)); }
            { u32 t = a + ((b & c) | (~b & d)) + m2 + (u32)4218488628; a = d; d = c; c = b; b = b + ((t << (u32)14) | (t >> (u32)18)); }
            { u32 t = a + ((b & c) | (~b & d)) + m3 + (u32)4143603128; a = d; d = c; c = b; b = b + ((t << (u32)20) | (t >> (u32)12)); }
            { u32 t = a + ((b & c) | (~b & d)) + m0 + (u32)2269380278; a = d; d = c; c = b; b = b + ((t << (u32)4) | (t >> (u32)28)); }
            { u32 t = a + ((b & c) | (~b & d)) + m1 + (u32)255770067; a = d; d = c; c = b; b = b + ((t << (u32)11) | (t >> (u32)21)); }
            { u32 t = a + ((b & c) | (~b & d)) + m2 + (u32)1992583342; a = d; d = c; c = b; b = b + ((t << (u32)16) | (t >> (u32)16)); }
            { u32 t = a + ((b & c) | (~b & d)) + m3 + (u32)3618196973; a = d; d = c; c = b; b = b + ((t << (u32)23) | (t >> (u32)9)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m0 + (u32)2229621088; a = d; d = c; c = b; b = b + ((t << (u32)6) | (t >> (u32)26)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m1 + (u32)2750031949; a = d; d = c; c = b; b = b + ((t << (u32)10) | (t >> (u32)22)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m2 + (u32)2146509353; a = d; d = c; c = b; b = b + ((t << (u32)15) | (t >> (u32)17)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m3 + (u32)2845199087; a = d; d = c; c = b; b = b + ((t << (u32)21) | (t >> (u32)11)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m0 + (u32)1194700572; a = d; d = c; c = b; b = b + ((t << (u32)7) | (t >> (u32)25)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m1 + (u32)3608698330; a = d; d = c; c = b; b = b + ((t << (u32)12) | (t >> (u32)20)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m2 + (u32)3040019196; a = d; d = c; c = b; b = b + ((t << (u32)17) | (t >> (u32)15)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m3 + (u32)1241417136; a = d; d = c; c = b; b = b + ((t << (u32)22) | (t >> (u32)10)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m0 + (u32)3291181424; a = d; d = c; c = b; b = b + ((t << (u32)5) | (t >> (u32)27)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m1 + (u32)1719704081; a = d; d = c; c = b; b = b + ((t << (u32)9) | (t >> (u32)23)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m2 + (u32)3636048988; a = d; d = c; c = b; b = b + ((t << (u32)14) | (t >> (u32)18)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m3 + (u32)1660063002; a = d; d = c; c = b; b = b + ((t << (u32)20) | (t >> (u32)12)); }
            { u32 t = a + (b ^ c ^ d) + m0 + (u32)4114760733; a = d; d = c; c = b; b = b + ((t << (u32)4) | (t >> (u32)28)); }
            { u32 t = a + (b ^ c ^ d) + m1 + (u32)2340482; a = d; d = c; c = b; b = b + ((t << (u32)11) | (t >> (u32)21)); }
            { u32 t = a + (b ^ c ^ d) + m2 + (u32)3909588191; a = d; d = c; c = b; b = b + ((t << (u32)16) | (t >> (u32)16)); }
            { u32 t = a + (b ^ c ^ d) + m3 + (u32)2018579976; a = d; d = c; c = b; b = b + ((t << (u32)23) | (t >> (u32)9)); }
            { u32 t = a + (b ^ c ^ d) + m0 + (u32)1706924747; a = d; d = c; c = b; b = b + ((t << (u32)6) | (t >> (u32)26)); }
            { u32 t = a + (b ^ c ^ d) + m1 + (u32)2703488257; a = d; d = c; c = b; b = b + ((t << (u32)10) | (t >> (u32)22)); }
            { u32 t = a + (b ^ c ^ d) + m2 + (u32)1158677336; a = d; d = c; c = b; b = b + ((t << (u32)15) | (t >> (u32)17)); }
            { u32 t = a + (b ^ c ^ d) + m3 + (u32)374281491; a = d; d = c; c = b; b = b + ((t << (u32)21) | (t >> (u32)11)); }
            { u32 t = a + (b ^ c ^ d) + m0 + (u32)1428444401; a = d; d = c; c = b; b = b + ((t << (u32)7) | (t >> (u32)25)); }
            { u32 t = a + (b ^ c ^ d) + m1 + (u32)4140675832; a = d; d = c; c = b; b = b + ((t << (u32)12) | (t >> (u32)20)); }
            { u32 t = a + (b ^ c ^ d) + m2 + (u32)506770417; a = d; d = c; c = b; b = b + ((t << (u32)17) | (t >> (u32)15)); }
            { u32 t = a + (b ^ c ^ d) + m3 + (u32)433990593; a = d; d = c; c = b; b = b + ((t << (u32)22) | (t >> (u32)10)); }
            { u32 t = a + (c ^ (b | ~d)) + m0 + (u32)257240212; a = d; d = c; c = b; b = b + ((t << (u32)5) | (t >> (u32)27)); }
            { u32 t = a + (c ^ (b | ~d)) + m1 + (u32)3423181342; a = d; d = c; c = b; b = b + ((t << (u32)9) | (t >> (u32)23)); }
            { u32 t = a + (c ^ (b | ~d)) + m2 + (u32)2402154336; a = d; d = c; c = b; b = b + ((t << (u32)14) | (t >> (u32)18)); }
            { u32 t = a + (c ^ (b | ~d)) + m3 + (u32)562499339; a = d; d = c; c = b; b = b + ((t << (u32)20) | (t >> (u32)12)); }
            { u32 t = a + (c ^ (b | ~d)) + m0 + (u32)2764735410; a = d; d = c; c = b; b = b + ((t << (u32)4) | (t >> (u32)28)); }
            { u32 t = a + (c ^ (b | ~d)) + m1 + (u32)500398015; a = d; d = c; c = b; b = b + ((t << (u32)11) | (t >> (u32)21)); }
            { u32 t = a + (c ^ (b | ~d)) + m2 + (u32)914251117; a = d; d = c; c = b; b = b + ((t << (u32)16) | (t >> (u32)16)); }
            { u32 t = a + (c ^ (b | ~d)) + m3 + (u32)3800466732; a = d; d = c; c = b; b = b + ((t << (u32)23) | (t >> (u32)9)); }
            { u32 t = a + (c ^ (b | ~d)) + m0 + (u32)904993522; a = d; d = c; c = b; b = b + ((t << (u32)6) | (t >> (u32)26)); }
            { u32 t = a + (c ^ (b | ~d)) + m1 + (u32)430925917; a = d; d = c; c = b; b = b + ((t << (u32)10) | (t >> (u32)22)); }
            { u32 t = a + (c ^ (b | ~d)) + m2 + (u32)4249018436; a = d; d = c; c = b; b = b + ((t << (u32)15) | (t >> (u32)17)); }
            { u32 t = a + (c ^ (b | ~d)) + m3 + (u32)915873307; a = d; d = c; c = b; b = b + ((t << (u32)21) | (t >> (u32)11)); }
            total = total + a + b + c + d;
        }
    return total;
}

float roundsWithFloat(u32 n, float scale)
{
    u32 total = (u32)0;
    for (u32 i in 0..n)
        {
            u32 m0 = i;
            u32 m1 = i * (u32)3;
            u32 m2 = i ^ (u32)0x5bd1e995;
            u32 m3 = i + (u32)7;
            u32 a = (u32)0x67452301;
            u32 b = (u32)0xefcdab89;
            u32 c = (u32)0x98badcfe;
            u32 d = (u32)0x10325476;
            { u32 t = a + ((b & c) | (~b & d)) + m0 + (u32)1999951809; a = d; d = c; c = b; b = b + ((t << (u32)7) | (t >> (u32)25)); }
            { u32 t = a + ((b & c) | (~b & d)) + m1 + (u32)2522798642; a = d; d = c; c = b; b = b + ((t << (u32)12) | (t >> (u32)20)); }
            { u32 t = a + ((b & c) | (~b & d)) + m2 + (u32)2198630850; a = d; d = c; c = b; b = b + ((t << (u32)17) | (t >> (u32)15)); }
            { u32 t = a + ((b & c) | (~b & d)) + m3 + (u32)3405809747; a = d; d = c; c = b; b = b + ((t << (u32)22) | (t >> (u32)10)); }
            { u32 t = a + ((b & c) | (~b & d)) + m0 + (u32)404257171; a = d; d = c; c = b; b = b + ((t << (u32)5) | (t >> (u32)27)); }
            { u32 t = a + ((b & c) | (~b & d)) + m1 + (u32)1303098497; a = d; d = c; c = b; b = b + ((t << (u32)9) | (t >> (u32)23)); }
            { u32 t = a + ((b & c) | (~b & d)) + m2 + (u32)4218488628; a = d; d = c; c = b; b = b + ((t << (u32)14) | (t >> (u32)18)); }
            { u32 t = a + ((b & c) | (~b & d)) + m3 + (u32)4143603128; a = d; d = c; c = b; b = b + ((t << (u32)20) | (t >> (u32)12)); }
            { u32 t = a + ((b & c) | (~b & d)) + m0 + (u32)2269380278; a = d; d = c; c = b; b = b + ((t << (u32)4) | (t >> (u32)28)); }
            { u32 t = a + ((b & c) | (~b & d)) + m1 + (u32)255770067; a = d; d = c; c = b; b = b + ((t << (u32)11) | (t >> (u32)21)); }
            { u32 t = a + ((b & c) | (~b & d)) + m2 + (u32)1992583342; a = d; d = c; c = b; b = b + ((t << (u32)16) | (t >> (u32)16)); }
            { u32 t = a + ((b & c) | (~b & d)) + m3 + (u32)3618196973; a = d; d = c; c = b; b = b + ((t << (u32)23) | (t >> (u32)9)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m0 + (u32)2229621088; a = d; d = c; c = b; b = b + ((t << (u32)6) | (t >> (u32)26)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m1 + (u32)2750031949; a = d; d = c; c = b; b = b + ((t << (u32)10) | (t >> (u32)22)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m2 + (u32)2146509353; a = d; d = c; c = b; b = b + ((t << (u32)15) | (t >> (u32)17)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m3 + (u32)2845199087; a = d; d = c; c = b; b = b + ((t << (u32)21) | (t >> (u32)11)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m0 + (u32)1194700572; a = d; d = c; c = b; b = b + ((t << (u32)7) | (t >> (u32)25)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m1 + (u32)3608698330; a = d; d = c; c = b; b = b + ((t << (u32)12) | (t >> (u32)20)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m2 + (u32)3040019196; a = d; d = c; c = b; b = b + ((t << (u32)17) | (t >> (u32)15)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m3 + (u32)1241417136; a = d; d = c; c = b; b = b + ((t << (u32)22) | (t >> (u32)10)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m0 + (u32)3291181424; a = d; d = c; c = b; b = b + ((t << (u32)5) | (t >> (u32)27)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m1 + (u32)1719704081; a = d; d = c; c = b; b = b + ((t << (u32)9) | (t >> (u32)23)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m2 + (u32)3636048988; a = d; d = c; c = b; b = b + ((t << (u32)14) | (t >> (u32)18)); }
            { u32 t = a + ((b & d) | (c & ~d)) + m3 + (u32)1660063002; a = d; d = c; c = b; b = b + ((t << (u32)20) | (t >> (u32)12)); }
            { u32 t = a + (b ^ c ^ d) + m0 + (u32)4114760733; a = d; d = c; c = b; b = b + ((t << (u32)4) | (t >> (u32)28)); }
            { u32 t = a + (b ^ c ^ d) + m1 + (u32)2340482; a = d; d = c; c = b; b = b + ((t << (u32)11) | (t >> (u32)21)); }
            { u32 t = a + (b ^ c ^ d) + m2 + (u32)3909588191; a = d; d = c; c = b; b = b + ((t << (u32)16) | (t >> (u32)16)); }
            { u32 t = a + (b ^ c ^ d) + m3 + (u32)2018579976; a = d; d = c; c = b; b = b + ((t << (u32)23) | (t >> (u32)9)); }
            { u32 t = a + (b ^ c ^ d) + m0 + (u32)1706924747; a = d; d = c; c = b; b = b + ((t << (u32)6) | (t >> (u32)26)); }
            { u32 t = a + (b ^ c ^ d) + m1 + (u32)2703488257; a = d; d = c; c = b; b = b + ((t << (u32)10) | (t >> (u32)22)); }
            { u32 t = a + (b ^ c ^ d) + m2 + (u32)1158677336; a = d; d = c; c = b; b = b + ((t << (u32)15) | (t >> (u32)17)); }
            { u32 t = a + (b ^ c ^ d) + m3 + (u32)374281491; a = d; d = c; c = b; b = b + ((t << (u32)21) | (t >> (u32)11)); }
            { u32 t = a + (b ^ c ^ d) + m0 + (u32)1428444401; a = d; d = c; c = b; b = b + ((t << (u32)7) | (t >> (u32)25)); }
            { u32 t = a + (b ^ c ^ d) + m1 + (u32)4140675832; a = d; d = c; c = b; b = b + ((t << (u32)12) | (t >> (u32)20)); }
            { u32 t = a + (b ^ c ^ d) + m2 + (u32)506770417; a = d; d = c; c = b; b = b + ((t << (u32)17) | (t >> (u32)15)); }
            { u32 t = a + (b ^ c ^ d) + m3 + (u32)433990593; a = d; d = c; c = b; b = b + ((t << (u32)22) | (t >> (u32)10)); }
            { u32 t = a + (c ^ (b | ~d)) + m0 + (u32)257240212; a = d; d = c; c = b; b = b + ((t << (u32)5) | (t >> (u32)27)); }
            { u32 t = a + (c ^ (b | ~d)) + m1 + (u32)3423181342; a = d; d = c; c = b; b = b + ((t << (u32)9) | (t >> (u32)23)); }
            { u32 t = a + (c ^ (b | ~d)) + m2 + (u32)2402154336; a = d; d = c; c = b; b = b + ((t << (u32)14) | (t >> (u32)18)); }
            { u32 t = a + (c ^ (b | ~d)) + m3 + (u32)562499339; a = d; d = c; c = b; b = b + ((t << (u32)20) | (t >> (u32)12)); }
            { u32 t = a + (c ^ (b | ~d)) + m0 + (u32)2764735410; a = d; d = c; c = b; b = b + ((t << (u32)4) | (t >> (u32)28)); }
            { u32 t = a + (c ^ (b | ~d)) + m1 + (u32)500398015; a = d; d = c; c = b; b = b + ((t << (u32)11) | (t >> (u32)21)); }
            { u32 t = a + (c ^ (b | ~d)) + m2 + (u32)914251117; a = d; d = c; c = b; b = b + ((t << (u32)16) | (t >> (u32)16)); }
            { u32 t = a + (c ^ (b | ~d)) + m3 + (u32)3800466732; a = d; d = c; c = b; b = b + ((t << (u32)23) | (t >> (u32)9)); }
            { u32 t = a + (c ^ (b | ~d)) + m0 + (u32)904993522; a = d; d = c; c = b; b = b + ((t << (u32)6) | (t >> (u32)26)); }
            { u32 t = a + (c ^ (b | ~d)) + m1 + (u32)430925917; a = d; d = c; c = b; b = b + ((t << (u32)10) | (t >> (u32)22)); }
            { u32 t = a + (c ^ (b | ~d)) + m2 + (u32)4249018436; a = d; d = c; c = b; b = b + ((t << (u32)15) | (t >> (u32)17)); }
            { u32 t = a + (c ^ (b | ~d)) + m3 + (u32)915873307; a = d; d = c; c = b; b = b + ((t << (u32)21) | (t >> (u32)11)); }
            total = total + a + b + c + d;
        }
    return (float)(total & (u32)0xffff) * scale;
}

i32 main(void)
{
    Stdio.printf("rounds %u\n", rounds((u32)0, (u32)1003));
    Stdio.printf("from 5 %u\n", rounds((u32)5, (u32)1003));
    Stdio.printf("short %u\n", rounds((u32)3, (u32)9));
    Stdio.printf("float %.1f\n", (double)roundsWithFloat((u32)997, 0.5f));
    u32 tot = (u32)0;
    par :reduce(+ tot)
    {
        for (u32 i in 0..40009)
            {
            u32 m0 = i;
            u32 m1 = i * (u32)3;
            u32 m2 = i ^ (u32)0x5bd1e995;
            u32 m3 = i + (u32)7;
            u32 a = (u32)0x67452301;
            u32 b = (u32)0xefcdab89;
            u32 c = (u32)0x98badcfe;
            u32 d = (u32)0x10325476;
            { u32 t = a + ((b & c) | (~b & d)) + m0 + (u32)1999951809; a = d; d = c; c = b; b = b + ((t << (u32)7) | (t >> (u32)25)); }
            { u32 t = a + ((b & c) | (~b & d)) + m1 + (u32)2522798642; a = d; d = c; c = b; b = b + ((t << (u32)12) | (t >> (u32)20)); }
            { u32 t = a + ((b & c) | (~b & d)) + m2 + (u32)2198630850; a = d; d = c; c = b; b = b + ((t << (u32)17) | (t >> (u32)15)); }
            { u32 t = a + ((b & c) | (~b & d)) + m3 + (u32)3405809747; a = d; d = c; c = b; b = b + ((t << (u32)22) | (t >> (u32)10)); }
            { u32 t = a + ((b & c) | (~b & d)) + m0 + (u32)404257171; a = d; d = c; c = b; b = b + ((t << (u32)5) | (t >> (u32)27)); }
