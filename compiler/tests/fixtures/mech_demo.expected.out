=== MECH math coprocessor demo (xt6502) ===
[int]   1000000 / 7 = 142857   rem 1
[int]   -98765 / 11 = -8978   rem -7
[f32]   3.5 + 1.25 = 4.750000
[f32]   3.5 * 1.25 = 4.375000
[f32]   3.5 / 1.25 = 2.800000
[f64]   2 / 3       = 0.66666666
[f64]   pi          = 3.14159265
[math]  sqrt(2)     = 1.41421356
[math]  sqrt(1000000) = 1000.0000
[math]  exp(1)      = 2.71828182
[math]  sin(1)      = 0.84147098
[math]  cos(1)      = 0.54030230
[conv]  (i32)(e * 1e6) = 2718281
[conv]  back to f32 / 1e6 = 2.718281
[expr]  area of circle r=4 = 50.26548
