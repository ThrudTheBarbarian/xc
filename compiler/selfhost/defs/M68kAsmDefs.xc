// M68kAsmDefs.xc — the constants of M68kAsm.xc.xc, apart from its code so a file
// compiled against its interface (the split build) can still see them.
#define MOP_DREG 0
#define MOP_AREG 1
#define MOP_IMM 2
#define MOP_IND 3
#define MOP_INDDISP 4
#define MOP_PREDEC 5
#define MOP_POSTINC 6
#define MOP_ABS 7
#define MOP_PCDISP 8
#define MOP_FREG 9
#define MOP_INDEX 10
#define MOP_NONE 11
