// XtaDefs.xc — the constants of Xta.xc.xc, apart from its code so a file
// compiled against its interface (the split build) can still see them.
#define LT_EMPTY 0
#define LT_LABEL 1
#define LT_INSTRUCTION 2
#define LT_ASSIGNMENT 3
#define LT_ORG 4
#define LT_BYTE 5
#define LT_WORD 6
#define LT_LONG 7
#define LT_STRING 8
#define LT_SPACE 9
#define LT_CODE_REGIONS 10
#define LT_BANK 11
#define LT_SPILL_POINT 12
#define LT_SHADOW_RANGES 13
#define LT_SHADOW_STAGE 14
#define LT_CLOAKED_BEGIN 15
#define LT_CLOAKED_END 16
