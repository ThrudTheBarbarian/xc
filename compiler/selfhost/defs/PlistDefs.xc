// PlistDefs.xc — the constants of Plist.xc.xc, apart from its code so a file
// compiled against its interface (the split build) can still see them.
#define PL_DICT $1
#define PL_ARRAY $2
#define PL_STRING $3
#define PL_TRUE $4
#define PL_FALSE $5
#define PL_INTEGER $6
#define PL_REAL $7
#define PL_DATE $8
#define PL_DATA $9
