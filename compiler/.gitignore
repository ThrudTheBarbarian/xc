# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

# CocoaPods
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# Pods/
#
# Add this line if you want to avoid checking in source code from the Xcode workspace
# *.xcworkspace

# Carthage
#
# Add this line if you want to avoid checking in source code from Carthage dependencies.
# Carthage/Checkouts

Carthage/Build/

# fastlane
#
# It is recommended to not store the screenshots in the git repo.
# Instead, use fastlane to re-generate the screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/#source-control

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# xtc build outputs — support/**/*.asm sources are kept tracked
*.xex
*.asm
!support/**/*.asm
!tests/**/*.asm

# OSX
.DS_Store

# Build-artifact directories
bin/
build/

# Distribution archives — staged into the website's public/ tree by `make dist`
web/site/public/downloads/xtc-*.tar.bz2
web/site/public/downloads/xtc-*.zip

# Site bundle produced by `make distrib`
web/site/xtc-site-*.tar.bz2


# Object files
*.o

# Depfiles (generated by clang -MMD for header-dep tracking)
*.d

# Python byproducts
*.pyc
__pycache__/

# Ephemeral abandon-reason tally (regenerated each `make corpus`)
doc/abandon-reasons.*.txt

# mimalloc ships as a prebuilt OBJECT for -fmalloc=mimalloc (support/MIMALLOC.md).
# It has to be committed: it is a link input the compiler reaches for by path, so
# a gitignored copy works on the machine that built it and is missing everywhere
# else. Regeneration command is in support/MIMALLOC.md.
!support/x86_64/runtime/mimalloc.o

# Never commit signing keys (ASC API .p8, exported identities)
*.p8
keys/

# Vendored Mbed TLS static archives (large, reproducible) — not tracked
3p/tls/mbedtls-linux/*.a

# tests/fixtures/files_roundtrip.xc writes this in the working directory
files_roundtrip.tmp
