// Generated by xcc-ln-wasm32 — loader for __BASE__.wasm (Node.js + browser + Worker).
// Node:    node __BASE__.js
// Browser: <script src="__BASE__.js"></script> (with __BASE__.wasm beside the page)
// Worker run loop: set globalThis.xccConfig = { runLoop: "worker" } BEFORE the
// script tag (needs COOP/COEP headers for SharedArrayBuffer).
(async () => {
  const isNode = typeof process !== "undefined" && !!(process.versions && process.versions.node);
  const isWorker = !isNode && typeof importScripts === "function";
  const cfg = (!isNode && !isWorker && globalThis.xccConfig) || {};
  let XCC = null;   // this module's handle; see where it is assigned

  // ── Worker-mode MAIN-THREAD side: own the DOM, feed the ring, spawn. ──
  // Also where a THREADED program's page goes (below): blocking is illegal on
  // the page thread, so its main runs in a Worker.
  const pageWorker = () => {
    if (typeof SharedArrayBuffer === "undefined")
      throw new Error("xcc: the worker run loop needs SharedArrayBuffer — serve with COOP/COEP headers");
    const ring = new SharedArrayBuffer(cfg.ringBytes || 4096);
    const i32 = new Int32Array(ring);
    const cap = (i32.length - 8) >> 3;
    const push = (t, a=0, b=0, c=0, d=0, e=0, f=0, g=0) => {
      const w = Atomics.load(i32, 0);
      if (w - Atomics.load(i32, 1) >= cap) Atomics.add(i32, 1, 1); // drop oldest
      const s = 8 + (w % cap) * 8;
      i32[s]=t|0; i32[s+1]=a|0; i32[s+2]=b|0; i32[s+3]=c|0;
      i32[s+4]=d|0; i32[s+5]=e|0; i32[s+6]=f|0; i32[s+7]=g|0;
      Atomics.store(i32, 0, w + 1);
      Atomics.notify(i32, 0);
    };
    globalThis.xccPushEvent = push;
    const canvas = cfg.canvas ? document.querySelector(cfg.canvas)
                              : document.getElementById("xcc-canvas");
    if (canvas) {
      canvas.addEventListener("mousedown", (e) => push(1, e.offsetX, e.offsetY, e.button));
      canvas.addEventListener("mouseup",   (e) => push(2, e.offsetX, e.offsetY, e.button));
      canvas.addEventListener("mousemove", (e) => push(3, e.offsetX, e.offsetY));
      window.addEventListener("keydown",   (e) => push(4, e.keyCode));
      window.addEventListener("keyup",     (e) => push(5, e.keyCode));
      // The wheel, as type 8 (7 is a modal's answer): the vertical delta in
      // PIXELS, so a line scroll is 100 and a page the canvas's height, as
      // WebKit measures them. Not passive, so the page itself does not scroll.
      canvas.addEventListener("wheel", (e) => {
        e.preventDefault();
        const px = e.deltaMode === 1 ? e.deltaY * 100
                 : e.deltaMode === 2 ? e.deltaY * canvas.clientHeight : e.deltaY;
        push(8, e.offsetX, e.offsetY, Math.round(px));
      }, { passive: false });
      // The right button arrives as mousedown 2; the browser's own menu must
      // not open over it.
      canvas.addEventListener("contextmenu", (e) => e.preventDefault());
    }
    const off = (canvas && canvas.transferControlToOffscreen)
              ? canvas.transferControlToOffscreen() : null;
    const url = (document.currentScript && document.currentScript.src) || "__BASE__.js";
    const worker = new Worker(url);
    // An error inside the worker, on the page's console.
    worker.onerror = (e) => console.error(`xcc: ${e.message || e}`);
    worker.onmessage = (m) => {
      const d = m.data || {};
      if (d.xccOut !== undefined) { (globalThis.xccOut || console.log)(d.xccOut); return; }
      if (d.xccLog !== undefined) {   // Log.* from the worker: the page's hook, or its console
        if (globalThis.xccLog) globalThis.xccLog(d.xccLog, d.lvl);
        else (d.lvl >= 2 ? console.error : d.lvl === 1 ? console.warn : console.log)(d.xccLog);
        return;
      }
      if (d.xccMsg !== undefined) { (globalThis.xccOnMessage || (() => {}))(d.xccMsg); return; }
      if (d.xccReq !== undefined) {
        const v = (globalThis.xccOnRequest || (() => 0))(d.xccReq) | 0;
        Atomics.store(i32, 3, v);
        Atomics.store(i32, 2, d.xccReq.seq | 0);
        Atomics.notify(i32, 2);
        return;
      }
      if (d.xccPool !== undefined) { startPool(d.xccPool); return; }
      if (d.xccExit) console.warn(`main() returned ${d.xccExit}`);
    };
    // A threaded program's pool (the worker side explains why it is the
    // page's): `want` workers now, then one more whenever runs wait in the
    // queue and no worker is idle or starting.
    const startPool = (p) => {
      const q = new Int32Array(p.queue);
      const add = () => {
        Atomics.add(q, 3, 1);
        const w = new Worker(url);
        w.onerror = worker.onerror;
        w.onmessage = worker.onmessage;
        w.postMessage({ xccThread: { module: p.module, memory: p.memory, queue: p.queue }, env: p.env });
      };
      for (let k = 0; k < p.want; k++) add();
      setInterval(() => {
        const waiting = Atomics.load(q, 1) - Atomics.load(q, 0);
        if (waiting > Atomics.load(q, 2) + Atomics.load(q, 3)) add();
      }, 20);
    };
    worker.postMessage({ ring, canvas: off,
                         workerScript: cfg.workerScript || null,
                         workerData: cfg.workerData,
                         // The page's environment (xccEnv / xccConfig.env), so
                         // XC_PAR_REPORT and friends reach the program in the worker.
                         env: globalThis.xccEnv || cfg.env || null },
                       off ? [off] : []);
  };
  if (cfg.runLoop === "worker") { pageWorker(); return; }
  // A thread of a threaded program (wasm32-threads.md): this script again, in
  // a Worker (or Node worker_threads), told which module, memory and bound
  // method to run.
  const nodeWT = isNode ? require("worker_threads") : null;
  let threadBoot = isNode && nodeWT.workerData ? nodeWT.workerData.xccThread || null : null;

  // ── Node, plain browser, or the WORKER side: instantiate and run. ──
  let ringI32 = null, reqSeq = 0;
  if (isWorker) {
    const boot = await new Promise((res) => { self.onmessage = (m) => res(m.data); });
    if (boot.xccThread) threadBoot = boot.xccThread;
    if (boot.ring) ringI32 = new Int32Array(boot.ring);
    globalThis.xccCanvas = boot.canvas || null;   // OffscreenCanvas for the driver
    // The page's xccConfig.workerData (any structured-cloneable value), set
    // BEFORE workerScript runs: a worker has no localStorage, so a page can
    // hand its shim a snapshot of whatever state it keeps there.
    globalThis.xccWorkerData = boot.workerData;
    if (boot.env) globalThis.xccEnv = boot.env;
    if (boot.workerScript) importScripts(boot.workerScript); // may set xccImports HERE
  }
  let line = [];
  // Output is UTF-8: decoded as such (one byte a character turned é into
  // Ã©), streaming, so a character split at the 4 KiB flush survives.
  const outDec = new TextDecoder("utf-8");
  const flush = () => {
    if (!line.length) return;
    const text = outDec.decode(new Uint8Array(line), { stream: true }); line = [];
    if (isNode) process.stdout.write(text);
    else if (isWorker) self.postMessage({ xccOut: text.replace(/\n$/, "") });
    else (globalThis.xccOut || console.log)(text.replace(/\n$/, ""));
  };
  let rndState = 0x2545F491;
  const rnd32 = () => {
    rndState ^= rndState << 13; rndState >>>= 0;
    rndState ^= rndState >> 17;
    rndState ^= rndState << 5;  rndState >>>= 0;
    return rndState;
  };
  const putc = (c) => { line.push(c & 0xFF); if ((c & 0xFF) === 10 || line.length > 4096) flush(); };
  const emit = (s) => { for (const ch of s) putc(ch.charCodeAt(0)); };
  // Read a NUL-terminated string out of linear memory; copy one in.
  const mem8 = () => new Uint8Array(XCC.memory.buffer);
  const cdec = new TextDecoder();
  const cstr = (p) => { const m = mem8(); let e = p; while (m[e]) e++; return cdec.decode(m.subarray(p, e)); };
  const xccEnvValue = (k) => {
    const e = isNode ? process.env : (globalThis.xccEnv || cfg.env || {});
    const v = e[k];
    return v === undefined || v === null ? undefined : String(v);
  };
  const argvCache = new Map();
  const argvPtr = (i, s) => {
    const key = i < 0 ? -1 : i;
    if (argvCache.has(key)) return argvCache.get(key);
    const bytes = new TextEncoder().encode(s);
    const p = XCC.instance.exports._xt_browser_alloc(bytes.length + 1);
    mem8().set(bytes, p); mem8()[p + bytes.length] = 0;   // re-derive: alloc may grow memory
    argvCache.set(key, p);
    return p;
  };
  const base = {
    putc, _putc: putc,
    // Fixed-point float/double formatters, matching the corpus C stub's
    // printf("%.*f"): float defaults to 6 decimal places, double to 10.
    _xtc_pf:  (f) => emit(f.toFixed(6)),
    _xtc_pd:  (d) => emit(d.toFixed(10)),
    // Explicit `%.Nf` precision TRUNCATES (the reference _xtc_truncf
    // formats at N+1 digits and drops the last char); N=0 keeps the
    // 6 / 10 digit defaults.
    _xtc_pfp: (f, p) => emit(p ? f.toFixed(p + 1).slice(0, -1) : f.toFixed(6)),
    _xtc_pdp: (d, p) => emit(p ? d.toFixed(p + 1).slice(0, -1) : d.toFixed(10)),
    time_ms: () => Date.now() & 0x7FFFFFFF,
    getpid: () => 1,
    abs: (v) => Math.abs(v | 0) | 0,
    // SecureRandom.xc: the platform's CSPRNG, through a plain buffer
    // (getRandomValues refuses a view of shared memory), 64 KiB at a time.
    _xt_random_fill: (p, n) => {
      const c = globalThis.crypto;
      if (!c || !c.getRandomValues) return -1;
      for (let at = 0; at < n; at += 65536) {
        const k = Math.min(65536, n - at), b = new Uint8Array(k);
        c.getRandomValues(b);
        mem8().set(b, p + at);
      }
      return 0;
    },
    // Files.xc / Process.xc host surface (CI task #81). Node has a
    // filesystem and a command line; a page has neither, so there every
    // file call answers the way a missing file does and argc is 1.
    // Handles are node's fds. Modes are fopen's, with the `b` dropped.
    // `_xt_argv` hands the module a pointer, so the string is copied INTO
    // linear memory through the module's own `_xt_browser_alloc` (every
    // wasm32 build exports it — Platform.xc) once per index and kept.
    _xt_file_open: (p, m) => {
      if (!isNode) return -1;
      try { return require("fs").openSync(cstr(p), cstr(m).replace(/b/g, "")); } catch (e) { return -1; }
    },
    _xt_file_read: (fd, buf, n) => {
      if (!isNode) return -1;
      try { return require("fs").readSync(fd, mem8(), buf, n, null); } catch (e) { return -1; }
    },
    _xt_file_write: (fd, buf, n) => {
      if (!isNode) return -1;
      try { return require("fs").writeSync(fd, mem8(), buf, n); } catch (e) { return -1; }
    },
    _xt_file_close: (fd) => { if (isNode) { try { require("fs").closeSync(fd); } catch (e) {} } },
    _xt_file_size: (p) => {
      if (!isNode) return -1;
      try { return require("fs").statSync(cstr(p)).size; } catch (e) { return -1; }
    },
    _xt_file_exists: (p) => (isNode && require("fs").existsSync(cstr(p))) ? 1 : 0,
    _xt_file_exists_exact: (p) => {
      // The host filesystem may be case-insensitive (macOS); ask for the
      // real spelling and compare the last component.
      if (!isNode) return 0;
      try {
        const fs = require("fs"), path = require("path"), q = cstr(p);
        const real = fs.realpathSync.native(q);
        return path.basename(real) === path.basename(q) ? 1 : 0;
      } catch (e) { return 0; }
    },
    _xt_file_chmod_exec: (p) => {
      if (!isNode) return -1;
      try { require("fs").chmodSync(cstr(p), 0o755); return 0; } catch (e) { return -1; }
    },
    _xt_mkdir: (p) => {
      if (!isNode) return -1;
      try { require("fs").mkdirSync(cstr(p)); return 0; } catch (e) { return -1; }
    },
    _xt_argc: () => isNode ? Math.max(1, process.argv.length - 1) : 1,
    _xt_argv: (i) => {
      const args = isNode ? process.argv.slice(1) : [];
      const s = (i >= 0 && i < args.length) ? args[i] : "";
      return argvPtr(i, s);
    },
    _xt_exit: (c) => { if (isNode) process.exit(c | 0); throw new Error(`Process.exit(${c})`); },
    // Math.rand host surface: a seeded xorshift32 — deterministic per
    // seed; the rand fixtures assert BOUNDS, not a reference sequence.
    _xt_srand: (s) => { rndState = (s >>> 0) || 1; },
    _xt_rand_u32: rnd32,
    _xt_rand_f: () => Math.fround(0.5 + (rnd32() / 0x100000000) * 0.5),
    _xt_rand_d: () => 0.5 + (rnd32() / 0x100000000) * 0.5,
    // Math.xc's host surface (float variants round through fround).
    _xm_sqrt: Math.sqrt,  _xm_sqrtf: (x) => Math.fround(Math.sqrt(x)),
    _xm_sin:  Math.sin,   _xm_sinf:  (x) => Math.fround(Math.sin(x)),
    _xm_cos:  Math.cos,   _xm_cosf:  (x) => Math.fround(Math.cos(x)),
    _xm_tan:  Math.tan,   _xm_tanf:  (x) => Math.fround(Math.tan(x)),
    _xm_atan: Math.atan,  _xm_atanf: (x) => Math.fround(Math.atan(x)),
    _xm_atan2: Math.atan2, _xm_atan2f: (y, x) => Math.fround(Math.atan2(y, x)),
    _xm_exp:  Math.exp,   _xm_expf:  (x) => Math.fround(Math.exp(x)),
    _xm_log:  Math.log,   _xm_logf:  (x) => Math.fround(Math.log(x)),
    _xm_ln:   Math.log,   _xm_lnf:   (x) => Math.fround(Math.log(x)),
    _xm_pow:  Math.pow,   _xm_powf:  (x, y) => Math.fround(Math.pow(x, y)),
    _xm_floor: Math.floor, _xm_floorf: (x) => Math.fround(Math.floor(x)),
    _xm_ceil: Math.ceil,  _xm_ceilf: (x) => Math.fround(Math.ceil(x)),
    _xm_fabs: Math.abs,   _xm_fabsf: (x) => Math.fround(Math.abs(x)),
    _xm_fmod: (a, b) => a % b, _xm_fmodf: (a, b) => Math.fround(a % b),
    // The environment (Platform.env): Node's, or in a browser the page's
    // globalThis.xccEnv. The value's UTF-8 length, then its bytes.
    _xt_env_len: (p, n) => {
      const v = xccEnvValue(cdec.decode(mem8().subarray(p, p + n)));
      return v === undefined ? 0 : new TextEncoder().encode(v).length;
    },
    _xt_env_copy: (p, n, dst) => {
      const v = xccEnvValue(cdec.decode(mem8().subarray(p, p + n)));
      if (v !== undefined) mem8().set(new TextEncoder().encode(v), dst);
    },
    clock_gettime: (clk, ts) => {
      const ns = BigInt(Math.round(performance.now() * 1e6));
      const dv = new DataView(XCC.memory.buffer);
      dv.setBigInt64(ts, ns / 1000000000n, true);
      dv.setBigInt64(ts + 8, ns % 1000000000n, true);
      return 0;
    },
  };
  // ── Threads (wasm32-threads.md): the Thread / Mutex / Cond / Sem / Atomic /
  // ThreadLocal primitives over Atomics on the shared memory, and the
  // race-free static-init once. Sync objects are words from the module's own
  // heap (its exported _xtc_alloc / _xtc_free). Views are re-derived per call:
  // memory.grow replaces the buffer object.
  const i32v = () => new Int32Array(XCC.memory.buffer);
  // Made on first use: a page that is not isolated has no SharedArrayBuffer,
  // and must reach the check below that says so.
  let napWord = null;
  const nap = (ms) => {
    if (!napWord) napWord = new Int32Array(new SharedArrayBuffer(4));
    Atomics.wait(napWord, 0, 0, ms);
  };
  const xalloc = (n) => XCC.instance.exports._xtc_alloc(1, n, 0);
  const xfree = (p) => { if (p) XCC.instance.exports._xtc_free(p - 40); };
  const mutexLock = (m, i) => {
    let c = Atomics.compareExchange(m, i, 0, 1);
    if (c === 0) return;
    if (c !== 2) c = Atomics.exchange(m, i, 2);
    while (c !== 0) { Atomics.wait(m, i, 2); c = Atomics.exchange(m, i, 2); }
  };
  const mutexUnlock = (m, i) => {
    if (Atomics.sub(m, i, 1) !== 1) { Atomics.store(m, i, 0); Atomics.notify(m, i, 1); }
  };
  const word = (v) => { const p = xalloc(4); Atomics.store(i32v(), p >> 2, v | 0); return p; };
  const tls = new Map();
  const sinitMine = new Set();
  let spawnThread = () => 0;   // set once the module is known
  Object.assign(base, {
    _xt_thread_create: (code, recv) => spawnThread(code, recv),
    _xt_thread_join: (h) => {
      if (!h) return -1;
      const m = i32v();
      while (Atomics.load(m, h >> 2) === 0) Atomics.wait(m, h >> 2, 0);
      xfree(m[(h >> 2) + 1]);
      xfree(h);
      return 0;
    },
    // Word 2 of the handle: 1 detached, 2 finished. Whichever of the two
    // comes second frees the thread's stack and handle.
    _xt_thread_detach: (h) => {
      if (h && Atomics.exchange(i32v(), (h >> 2) + 2, 1) === 2) { xfree(i32v()[(h >> 2) + 1]); xfree(h); }
    },
    _xt_thread_yield: () => nap(0),
    _xt_thread_sleep_ms: (ms) => nap(ms >>> 0),
    _xt_thread_self_id: () => (XCC.instance.exports.__tid ? XCC.instance.exports.__tid.value : 1) >>> 0,
    _xt_thread_cpu_count: () => isNode ? require("os").cpus().length : (navigator.hardwareConcurrency || 1),
    _xt_mutex_new: () => word(0),
    _xt_mutex_free: xfree,
    _xt_mutex_lock: (p) => mutexLock(i32v(), p >> 2),
    _xt_mutex_unlock: (p) => mutexUnlock(i32v(), p >> 2),
    _xt_mutex_trylock: (p) => Atomics.compareExchange(i32v(), p >> 2, 0, 1) === 0 ? 1 : 0,
    // A condition is a sequence number: a waiter sleeps while it is unchanged.
    _xt_cond_new: () => word(0),
    _xt_cond_free: xfree,
    _xt_cond_wait: (c, mu) => {
      const m = i32v(), seq = Atomics.load(m, c >> 2);
      mutexUnlock(m, mu >> 2);
      Atomics.wait(m, c >> 2, seq);
      mutexLock(i32v(), mu >> 2);
    },
    _xt_cond_signal: (c) => { const m = i32v(); Atomics.add(m, c >> 2, 1); Atomics.notify(m, c >> 2, 1); },
    _xt_cond_broadcast: (c) => { const m = i32v(); Atomics.add(m, c >> 2, 1); Atomics.notify(m, c >> 2); },
    _xt_sem_new: (n) => word(n),
    _xt_sem_free: xfree,
    _xt_sem_wait: (sp) => {
      const m = i32v(), i = sp >> 2;
      for (;;) {
        const v = Atomics.load(m, i);
        if (v > 0) { if (Atomics.compareExchange(m, i, v, v - 1) === v) return; }
        else Atomics.wait(m, i, v);
      }
    },
    _xt_sem_trywait: (sp) => {
      const m = i32v(), i = sp >> 2;
      for (;;) {
        const v = Atomics.load(m, i);
        if (v <= 0) return 0;
        if (Atomics.compareExchange(m, i, v, v - 1) === v) return 1;
      }
    },
    _xt_sem_post: (sp) => { const m = i32v(); Atomics.add(m, sp >> 2, 1); Atomics.notify(m, sp >> 2, 1); },
    _xt_atomic_load_i32: (p) => p ? Atomics.load(i32v(), p >> 2) : 0,
    _xt_atomic_store_i32: (p, v) => { if (p) Atomics.store(i32v(), p >> 2, v); },
    _xt_atomic_add_i32: (p, d) => p ? (Atomics.add(i32v(), p >> 2, d) + d) | 0 : 0,
    _xt_atomic_xchg_i32: (p, v) => p ? Atomics.exchange(i32v(), p >> 2, v) : 0,
    _xt_atomic_cas_i32: (p, e, d) => p && Atomics.compareExchange(i32v(), p >> 2, e, d) === e ? 1 : 0,
    // Keys from a counter every thread shares (the module's __xt_rt + 16);
    // the values are this thread's own.
    _xt_tls_new: () => (Atomics.add(i32v(), (XCC.instance.exports.__xt_rt.value + 16) >> 2, 1) + 1) >>> 0,
    _xt_tls_set: (k, v) => { tls.set(k, v); },
    _xt_tls_get: (k) => tls.get(k) || 0,
    // A class's statics, initialised once whichever thread gets there first:
    // 0 → 1 claims, 2 publishes; the owner re-entering returns at once, any
    // other thread waits for 2.
    _xtc_sinit_run: (flag, init, sdata) => {
      if (!flag) return;
      for (;;) {
        const st = Atomics.load(mem8(), flag);
        if (st === 2) return;
        if (st === 0 && Atomics.compareExchange(mem8(), flag, 0, 1) === 0) {
          sinitMine.add(flag);
          try { XCC.instance.exports.__indirect_function_table.get(init)(sdata); }
          finally { sinitMine.delete(flag); Atomics.store(mem8(), flag, 2); }
          return;
        }
        if (sinitMine.has(flag)) return;
        nap(1);
      }
    },
  });
  if (isWorker && ringI32) {
    const ri = ringI32;
    // The blocking primitives (XG-WEB-BACKEND sec 3): the worker CAN block.
    // memory views are re-derived per call — memory.grow detaches buffers.
    // One blocking round trip to the page: post the request, then wait for the
    // page's reply in ring word 3. _xt_req_block sends raw wasm values.
    const reqBlock = (req) => {
      const seq = ++reqSeq;
      self.postMessage({ xccReq: Object.assign({ seq }, req) });
      for (;;) {
        const cur = Atomics.load(ri, 2);
        if (cur === seq) break;
        Atomics.wait(ri, 2, cur);
      }
      return Atomics.load(ri, 3);
    };
    // For a host package's worker shim, which reads its own strings out of
    // module memory: xccRequest blocks like _xt_req_block but carries any
    // structured-cloneable payload (the page's xccOnRequest gets
    // {seq, kind, payload}); xccPost hands a payload to the page's
    // xccOnMessage without waiting. The page answers back through
    // xccPushEvent.
    globalThis.xccRequest = (kind, payload) => reqBlock({ kind, payload });
    globalThis.xccPost = (payload) => self.postMessage({ xccMsg: payload });
