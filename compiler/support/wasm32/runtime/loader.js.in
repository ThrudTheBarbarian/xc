        const q = ex._xt_browser_alloc(b.length);
        mem8().set(b, q);
        ex._xt_plugin_cached(tok, q, b.length);
      });
    },
    _xt_plugin_trust_len: () => new TextEncoder().encode(trustRead()).length,
    _xt_plugin_trust_copy: (dst) => mem8().set(new TextEncoder().encode(trustRead()), dst),
    _xt_plugin_trust_set: (p, n) => trustWrite(cdec.decode(mem8().subarray(p, p + n))),
    // P.bind(t) in this program: t is a plugin's handle (Plugin.table).
    _xt_proto_bind: (p, n, h) => {
      const ns = cdec.decode(mem8().subarray(p, p + n));
      if (!h) { delete protoSlots[ns]; return; }
      const P = plugins[h];
      const shape = P && shapeOf(P.inst, () => P.inst.exports.memory, ns);
      if (!shape) throw new Error(`xcc: ${ns}.bind(): that plugin does not provide ${ns}`);
      const slots = {};
      for (const m of Object.keys(shape))
        slots[m] = bridge(() => XCC.memory, P.inst, () => P.inst.exports.memory, ns, m, shape[m]);
      protoSlots[ns] = slots;
    },
    // The verified code: copied out of this program's memory NOW (the bytes
    // just hashed), compiled and instantiated, then _xt_plugin_ready.
    _xt_plugin_instantiate: (tok, p, n) => {
      const code = new Uint8Array(XCC.memory.buffer).slice(p, p + n);
      const ex = XCC.instance.exports;
      const answer = (h, why) => {
        if (!why) { ex._xt_plugin_ready(tok, h, 0, 0); return; }
        const b = new TextEncoder().encode(why), q = ex._xt_browser_alloc(b.length);
        mem8().set(b, q);
        ex._xt_plugin_ready(tok, 0, q, b.length);
      };
      (async () => {
        const mod = await WebAssembly.compile(code);
        const P = { inst: null };
        const pim = {};
        const penv = pluginEnv(P);
        for (const i of WebAssembly.Module.imports(mod)) {
          if (i.kind !== "function")
            throw new Error(`it imports ${i.module}.${i.name}, a ${i.kind}; a plugin has its own memory and imports only functions`);
          const t = pim[i.module] || (pim[i.module] = {});
          const pre = `_XtP_${i.module}__`;
          if (i.name.startsWith(pre)) {
            const ns = i.module, m = i.name.slice(pre.length);
            const shape = shapeOf(XCC.instance, () => XCC.memory, ns);
            if (!shape || !(m in shape) || !ex[i.name])
              throw new Error(`it calls ${ns}.${m}, which this program does not provide`);
            t[i.name] = bridge(() => P.inst.exports.memory, XCC.instance, () => XCC.memory, ns, m, shape[m]);
          } else if (i.module === "env" && i.name in penv) {
            t[i.name] = penv[i.name];
          } else {
            const what = `${i.module}.${i.name}`;
            t[i.name] = () => { throw new Error(`xcc: a plugin may not call ${what}`); };
          }
        }
        P.inst = await WebAssembly.instantiate(mod, pim);
        if (P.inst.exports._xt_init) P.inst.exports._xt_init();
        plugins.push(P);
        return plugins.length - 1;
      })().then((h) => answer(h, null), (e) => answer(0, String(e && e.message || e)));
    },
  }, extra.xcplugin || {});
  const instance = await WebAssembly.instantiate(wasmModule, imports);
  const usesGpu = gpuJspi && WebAssembly.Module.imports(wasmModule).some((m) => m.module === "xcgpu");
  // A per-module handle. This used to be ONLY `globalThis.xcc`, so loading a
  // second independent module clobbered the first — and the clobber was not
  // cosmetic: the callbacks below read `XCC.memory`, so module A's
  // browser dispatch would start reading module B's memory. That is the
  // shared-NOTHING model (a group loading its own module on demand), where two
  // unrelated modules must coexist in one realm.
  //
  // `globalThis.xcc` still points at the most recent module, because callers
  // rely on it; `globalThis.xccModules[<base>]` is the stable per-module one,
  // and everything INSIDE this loader now closes over XCC instead.
  XCC = { instance, memory: sharedMemory || instance.exports.memory };
  globalThis.xcc = XCC;
  (globalThis.xccModules || (globalThis.xccModules = {}))["__BASE__"] = XCC;
  // Instantiate each dep: data goes BETWEEN the app's static data and the
  // 1 MiB heap base (so the ARC "is this a heap object" compare stays a
  // single guard — library statics must NOT read as heap objects), funcs
  // go at the grown end of the app's one table, env is thunked to the
  // app's exported runtime, and the dep's reloc-apply patches the vtable
  // words a data segment cannot compute. __stack_low is raised past the
  // last dep so the shadow stack cannot grow down into library data.
  // ── Spawning, from main or from any thread (wasm32-threads.md). A thread
  // gets a 256 KiB shadow stack and a handle {done, stack, detached} from the
  // heap. Node starts a worker per thread, from whichever thread spawns. A
  // browser cannot: a Worker starts only once its creator returns to its
  // event loop, which a thread that spawns and then joins never does. So
  // there a spawn goes into a queue in shared memory, and pool workers block
  // on that queue and run what arrives. The PAGE creates the pool workers (it
  // never blocks) and adds one whenever runs wait and none is idle, so any
  // thread may spawn, and there is no ceiling on how many run at once.
  //
  // The queue: words 0 head (next to take), 1 tail (next to fill), 2 idle
  // workers, 3 workers starting; then Q_CAP slots of 6 words, {code, recv,
  // handle, sp, low, seq + 1}, the last stored once the rest are written.
  const Q_CAP = 1024, Q_HDR = 8, Q_SLOT = 6;
  const STACK = 256 * 1024;
  const newRun = (code, recv) => {
    const h = xalloc(16), stack = xalloc(STACK);
    const m = i32v();
    m[h >> 2] = 0; m[(h >> 2) + 1] = stack; m[(h >> 2) + 2] = 0;
    return { code, recv, handle: h, sp: (stack + STACK) & ~15, low: stack };
  };
  const qPush = (q, r) => {
    let t;
    for (;;) {
      t = Atomics.load(q, 1);
      const h = Atomics.load(q, 0);
      if (t - h >= Q_CAP) { Atomics.wait(q, 0, h, 50); continue; }
      if (Atomics.compareExchange(q, 1, t, t + 1) === t) break;
    }
    const s = Q_HDR + (t % Q_CAP) * Q_SLOT;
    q[s] = r.code; q[s + 1] = r.recv; q[s + 2] = r.handle; q[s + 3] = r.sp; q[s + 4] = r.low;
    Atomics.store(q, s + 5, t + 1);
    Atomics.notify(q, s + 5);
    Atomics.notify(q, 1);
  };
  const qTake = (q) => {
    for (;;) {
      const h = Atomics.load(q, 0), t = Atomics.load(q, 1);
      if (h === t) {
        Atomics.add(q, 2, 1);
        Atomics.wait(q, 1, t);
        Atomics.sub(q, 2, 1);
        continue;
      }
      if (Atomics.compareExchange(q, 0, h, h + 1) !== h) continue;
      Atomics.notify(q, 0);
      const s = Q_HDR + (h % Q_CAP) * Q_SLOT;
      for (let v = Atomics.load(q, s + 5); v !== h + 1; v = Atomics.load(q, s + 5)) Atomics.wait(q, s + 5, v, 10);
      const r = { code: q[s], recv: q[s + 1], handle: q[s + 2], sp: q[s + 3], low: q[s + 4] };
      Atomics.store(q, s + 5, 0);
      return r;
    }
  };
  let poolQ = threadBoot && threadBoot.queue ? new Int32Array(threadBoot.queue) : null;
  if (threaded) {
    spawnThread = (code, recv) => {
      const run = newRun(code, recv);
      if (isNode) {
        new nodeWT.Worker(__filename, { workerData: { xccThread: Object.assign({ module: wasmModule, memory: sharedMemory }, run),
                                                       env: globalThis.xccEnv || null } });
        return run.handle;
      }
      qPush(poolQ, run);
      return run.handle;
    };
  }
  if (threadBoot) {
    // This instance is a thread: its own stack and id, then the bound method.
    // A browser's pool worker stays, and runs each thread the queue hands it.
    const ex = instance.exports;
    const runThread = (t) => {
      ex.__sp.value = t.sp;
      ex.__stack_low.value = t.low;
      ex.__tid.value = t.handle;
      tls.clear();
      sinitMine.clear();
      try { ex.__indirect_function_table.get(t.code)(t.recv); }
      catch (e) { flush(); console.error(e); }
      flush();
      const m = i32v();
      Atomics.store(m, t.handle >> 2, 1);
      Atomics.notify(m, t.handle >> 2);
      // Detached: nobody joins, so the thread frees its own stack (no longer
      // in use: the call has returned) and handle.
      if (Atomics.exchange(m, (t.handle >> 2) + 2, 2) === 1) { xfree(t.low); xfree(t.handle); }
    };
    if (!poolQ) {
      runThread(threadBoot);
      if (!isNode) self.close();
      return;
    }
    Atomics.sub(poolQ, 3, 1);
    for (;;) runThread(qTake(poolQ));
  }
  if (threaded) {
    instance.exports.__xt_init_memory();
    if (isWorker) {
      // The queue, and the page told to start the pool on it.
      poolQ = new Int32Array(new SharedArrayBuffer(4 * (Q_HDR + Q_CAP * Q_SLOT)));
      const want = (globalThis.xccConfig && globalThis.xccConfig.threadPool) ||
                   Math.max(4, Math.min(16, navigator.hardwareConcurrency || 4));
      self.postMessage({ xccPool: { module: wasmModule, memory: sharedMemory, queue: poolQ.buffer, want,
                                    env: globalThis.xccEnv || null } });
    }
  }
  let dcur = order.length ? instance.exports.__data_end.value : 0;
  for (const d of order) {
    const dbytes = libBytes[d], dmeta = libMeta[d];
    const dbase = (dcur + 15) & ~15;
    if (dbase < 0x10000) throw new Error(`xcc: lib${d} data base ${dbase} below 0x10000 (classid guard)`);
    if (dbase + dmeta.dataSize > 0x100000)
      throw new Error(`xcc: lib${d} data (${dmeta.dataSize} bytes at ${dbase}) overflows the pre-heap region`);
    const dtable = instance.exports.__indirect_function_table;
    const dtbase = dmeta.tableSize ? dtable.grow(dmeta.tableSize) : dtable.length;
    const denvBase = {
      memory: instance.exports.memory,
      __indirect_function_table: dtable,
      __memory_base: dbase, __table_base: dtbase,
      __sp: instance.exports.__sp, __stack_low: instance.exports.__stack_low,
    };
    const denv = new Proxy(denvBase, {
      get(t, n) {
        if (n in t) return t[n];
        if (n in instance.exports) return instance.exports[n];
        if (n in base) return base[n];
        return () => { throw new Error(`missing library import env.${String(n)} (lib${d})`); };
      },
    });
    // Start from the APP's import object, not just `extra`. The loader builds
    // the `browser` package itself (default implementations ship inside it), and
    // passing only the host-supplied `xccImports` meant a library using
    // `#package browser` died at instantiation with "Import #8 browser: module
    // is not an object or function" until the caller re-supplied it by hand.
    // env is the one entry that must be the DEP's thunked version.
    // A library that subclasses another library's class imports that
    // library's methods (into its own table slots) and __addr_ getters (for
    // its vtable words). A dep already instantiated is passed as its real
    // exports, so those table slots hold its wasm functions directly.
    const dimp = Object.assign({}, imports, { env: denv });
    for (const o of order) if (o !== d) dimp[o] = depExports[o] || imports[o];
    const di = await WebAssembly.instantiate(dbytes, dimp);
    depExports[d] = di.instance.exports;
    dcur = dbase + dmeta.dataSize;
  }
  // Relocate after every dep exists: a library's vtable words can name
  // another library's data, read through that library's __addr_ getter.
  // Relocating also runs the library's startup code, which may call into the
  // libraries it imports, so it goes in `order`: those are relocated first.
  for (const d of order) depExports[d].__wasm_apply_relocs();
  if (order.length) instance.exports.__stack_low.value = (dcur + 15) & ~15;
  const rc = usesGpu ? await WebAssembly.promising(instance.exports.main)() : instance.exports.main();
  flush();
  if (isNode) process.exitCode = rc | 0;
  else if (isWorker) self.postMessage({ xccExit: rc | 0 });
  else if (rc) console.warn(`main() returned ${rc}`);
})().catch((e) => {
  const isNode = typeof process !== "undefined" && !!(process.versions && process.versions.node);
  if (isNode) { console.error(e); process.exitCode = 70; }
  // In a worker the error goes to the page, whose console the user sees.
  else if (typeof importScripts === "function") self.postMessage({ xccLog: String(e && e.stack || e), lvl: 2 });
  else console.error(e);
});
