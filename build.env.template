# build.env.template
#
# Copy this file to build.env at the repository root and fill in the values
# for your machines. build.env is ignored by git.
#
# Scripts load it through tools/build-env.sh and makefiles read it directly.
# A variable already set in the environment takes precedence over build.env.
# A variable left empty turns off the step that needs it, and the script
# reports the skip.
#
# Format: NAME=value, one per line, no spaces around '=', no quotes.

# Machine that runs x86-64 Linux test binaries, reached with ssh and scp.
# Any ssh destination works: a host alias from your ssh config, or user@host.
XTC_LINUX_HOST=

# Optional per-suite overrides. Each falls back to XTC_LINUX_HOST when empty.
XTC_X86_HOST=
XTC_X86_64_HOST=
XTC_PERF_REMOTE=
UX_LINUX_HOST=

# Directory with the XTOS kernel and C library built for arm9 (the loader's
# build-xtc output): freertos-hosttest.elf, the kernel the fixtures run on, and
# libc.so, which supplies malloc and the C library to them. Build it from the
# loader checkout named in LOADER below (`make -C <loader> hosttest`, which also
# builds libc.so from its PIC newlib).
#
# The arm9 suites — `make corpus`'s arm9 leg, tests/corpus/arm9-quick.sh and
# selfhost/tools/a9-run.sh — need this and qemu-system-arm on PATH. Left empty,
# each reports the sysroot as absent rather than skipping quietly. `xcc -A arm9`
# itself needs a libc.so on its library search path, because arm9 output is a
# loader-hosted ET_DYN object rather than a bare-metal executable.
XTC_ARM9_SYSROOT=

# The Vitis-generated cortexa9_toolchain.cmake, or a directory to search for
# it. compiler/support/arm9/bsp-flags.sh reads the Cortex-A9 ABI flags from
# it; without it the documented defaults are used.
XTC_ARM9_BSP=

# Checkout of the XTOS loader. Building arm9 applications and romfs images
# needs it.
LOADER=

# Directory with the GEM libraries built for arm9 (the loader's build-xtg
# output).
GEMLIB=

# Checkout of the GEM desktop sources: themes, fonts and sample resources.
GEM_DIR=

# Earlier compiler and simulator binaries, used only to regenerate test
# oracles (compiler/tests/corpus/generate-oracles.sh).
LEGACY_XTC=
LEGACY_XTS=

# Website deployment (tools/release/deploy-website.sh): the ssh destination
# and the document root on that machine.
DEPLOY_HOST=
DEPLOY_DOCROOT=

# Address that receives messages sent through the website feedback form.
# The deploy script writes it into the published site; it is never committed.
FEEDBACK_RECIPIENT=
