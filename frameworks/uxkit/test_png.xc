void main(void)
    {
    for (i32 f = (i32)0; f < (i32)9; f = f + (i32)1)
        {
        u8* src = (u8*)0;
        u32* exp = (u32*)0;
        i32 w = (i32)0;
        i32 h = (i32)0;
        i32 ln = (i32)0;
        u8* nm = (u8*)0;
        if (f == (i32)0) { src = P_RGBA; exp = P_RGBA_EXP; w = (i32)8; h = (i32)8; nm = (u8*)"RGBA 8x8 (dynamic)"; ln = P_RGBA_LEN; }
        if (f == (i32)1) { src = P_RGB;  exp = P_RGB_EXP;  w = (i32)4; h = (i32)4; nm = (u8*)"RGB 4x4 (stored)"; ln = P_RGB_LEN; }
        if (f == (i32)2) { src = P_GREY; exp = P_GREY_EXP; w = (i32)5; h = (i32)3; nm = (u8*)"grey 5x3"; ln = P_GREY_LEN; }
        if (f == (i32)3) { src = P_PAL;  exp = P_PAL_EXP;  w = (i32)4; h = (i32)4; nm = (u8*)"palette+tRNS 4x4"; ln = P_PAL_LEN; }
        if (f == (i32)4) { src = P_1BIT; exp = P_1BIT_EXP; w = (i32)16; h = (i32)2; nm = (u8*)"grey 1-bit 16x2"; ln = P_1BIT_LEN; }
        if (f == (i32)5) { src = P16_RGBA; exp = P16_RGBA_EXP; w = (i32)4; h = (i32)2; nm = (u8*)"16-bit RGBA 4x2"; ln = P16_RGBA_LEN; }
        if (f == (i32)6) { src = P16_GREY; exp = P16_GREY_EXP; w = (i32)4; h = (i32)1; nm = (u8*)"16-bit grey+tRNS 4x1"; ln = P16_GREY_LEN; }
        if (f == (i32)7) { src = P16_RGBT; exp = P16_RGBT_EXP; w = (i32)4; h = (i32)1; nm = (u8*)"16-bit RGB+tRNS 4x1"; ln = P16_RGBT_LEN; }
        if (f == (i32)8) { src = P16_GA;   exp = P16_GA_EXP;   w = (i32)2; h = (i32)2; nm = (u8*)"16-bit grey+alpha 2x2"; ln = P16_GA_LEN; }
        UXImage* im = UXPng.decode(src, ln);
        if (im == (UXImage*)0)
            {
            Stdio.printf("  no: %s -> null\n", nm);
            gFails = gFails + 1;
            }
        else
            {
            if (im.width() != w || im.height() != h)
                {
                Stdio.printf("  no: %s is %dx%d\n", nm, im.width(), im.height());
                gFails = gFails + 1;
                }
            for (i32 y = (i32)0; y < h; y = y + (i32)1)
                {
                for (i32 x = (i32)0; x < w; x = x + (i32)1)
                    {
                    u32 got = im.pixelRaw(x, y);
                    u32 want = exp[y * w + x];
                    if (got != want)
                        {
                        Stdio.printf("  no: %s at %d,%d got %d want %d\n", nm, x, y, got, want);
                        gFails = gFails + 1;
                        }
                    }
                }
            }
        }

    // Refusals: an interlaced file and a file whose CRC does not check out.  Both must
    // come back null -- a half-image is worse than none, and a truncated download is
    // the failure this decoder will actually meet.
    ck(UXPng.decode(P_INT, P_INT_LEN) == (UXImage*)0, "interlaced is refused");
    ck(UXPng.decode(P_BADCRC, P_BADCRC_LEN) == (UXImage*)0, "a bad CRC is refused");
    ck(UXPng.decode(P_INT, (i32)4) == (UXImage*)0, "a truncated file is refused");
    ck(UXPng.decode(P_RGBA, (i32)0) == (UXImage*)0, "an empty file is refused");

    UXImage* m = UXPng.decode(P_RGBA, P_RGBA_LEN);
    UXColor* c0 = m.pixelAt((i32)0, (i32)0);
    Stdio.printf("  nine fixtures decoded; RGBA 8x8 pixel 0 = r%d g%d b%d a%d\n",
                 c0.r, c0.g, c0.b, c0.a);
    if (gFails == 0)
        {
        Stdio.printf("PASS: PNG — nine colour cases byte for byte, and four refusals\n");
        }
    else
        {
        Stdio.printf("FAIL: %d\n", gFails);
        }
    }
