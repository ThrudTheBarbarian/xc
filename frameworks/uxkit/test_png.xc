// Sixteen-bit samples.  The sheet the game ships is 16-bit RGBA, and eight bits of a
// 16-bit sample is its HIGH byte -- so every fixture below is built from values whose two
// bytes differ, and the expectations are the high bytes.  P16_RGBA also carries a row of
// zeros (alpha 0) so a run that dropped the alpha byte would show.  P16_GREY and P16_RGBT
// each carry a tRNS whose sample matches ONE pixel exactly and a second pixel that shares
// that pixel's high byte but not its low one -- the case a high-byte-only tRNS compare
// gets wrong, and the reason the chunk is read as whole samples here.
#define P16_RGBA_LEN 123
u8 P16_RGBA[] = {
    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D,
