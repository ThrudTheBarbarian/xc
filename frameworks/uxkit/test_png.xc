    0xFC, 0xDF, 0xC0, 0x00, 0x03, 0x82, 0x82, 0x4A, 0x4A, 0xC6, 0xC6, 0x2E,
    0x2E, 0xAB, 0x56, 0xED, 0xDE, 0x7D, 0xE6, 0xCC, 0xDD, 0xBB, 0x8C, 0x0C,
    0x4C, 0x0C, 0xCC, 0x0C, 0x2C, 0x0C, 0x00, 0x78, 0xF5, 0x17, 0x2D, 0x0E,
