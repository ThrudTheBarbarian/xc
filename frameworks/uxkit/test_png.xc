    0x42, 0x49, 0x44, 0x41, 0x54, 0x78, 0xDA, 0x63, 0x10, 0x32, 0x09, 0xAB,
    0x98, 0xB5, 0xE7, 0xDE, 0x87, 0xFF, 0xFF, 0x19, 0x18, 0x1A, 0x1A, 0x80,
