// test_png.xc — the PNG decoder against fixtures, byte for byte.
//
// The fixtures are generated (Python zlib) and pasted, which is the point: the decoder
// is checked against bytes it did not make.  Between them they cover the three deflate
// block types (dynamic, stored and fixed), all five colour types, sub-byte samples,
// palette alpha, and four refusals -- interlace, a bad CRC, a truncated file and an
// empty one.
#import <Stdio.xc>
#import "UXPng.xc"

i32 gFails = 0;
void ck(bool ok, u8* what)
    {
    if (!ok)
        {
        Stdio.printf("  no: %s\n", what);
        gFails = gFails + 1;
        }
    }

