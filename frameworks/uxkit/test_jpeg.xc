u32 rgbAt(UXImage* im, i32 x, i32 y)
    {
    return im.px[y * im.w + x] & (u32)$FFFFFF;
    }
u32 fnvOf(UXImage* im)
    {
    u32 h = (u32)$811C9DC5;
    for (i32 i = (i32)0; i < im.w * im.h; i = i + (i32)1)
        {
        u32 c = im.px[i];
        h = (h ^ ((c >> (u32)16) & (u32)255)) * (u32)$01000193;
        h = (h ^ ((c >> (u32)8) & (u32)255)) * (u32)$01000193;
        h = (h ^ (c & (u32)255)) * (u32)$01000193;
        }
    return h;
    }
void exact(u8* name, u8* data, i32 n, i32 w, i32 h, u32 fnv, u32 p0, u32 p1, u32 p2)
    {
    UXImage* im = UXJpeg.decode(data, n);
    if (im == (UXImage*)0)
        {
        Stdio.printf("  no: %s was refused\n", name);
        gFails = gFails + 1;
        return;
        }
    bool sized = im.w == w && im.h == h;
    bool same = sized && fnvOf(im) == fnv;
    if (!same)
        {
        Stdio.printf("  no: %s %dx%d (want %dx%d) hash %08x want %08x; pixels %06x %06x %06x want %06x %06x %06x\n",
                     name, im.w, im.h, w, h, fnvOf(im), fnv,
                     sized ? rgbAt(im, (i32)0, (i32)0) : (u32)0, sized ? rgbAt(im, w - (i32)1, h - (i32)1) : (u32)0,
                     sized ? rgbAt(im, w / (i32)2, h / (i32)2) : (u32)0, p0, p1, p2);
        gFails = gFails + 1;
        return;
        }
    Stdio.printf("  ok: %s %dx%d matches libjpeg byte for byte\n", name, w, h);
    }

void main(void)
    {
    exact((u8*)"4:2:0, partial MCUs", &J_S420[(i32)0], (i32)J_S420_LEN, (i32)J_S420_W, (i32)J_S420_H, (u32)J_S420_FNV, (u32)J_S420_P0, (u32)J_S420_P1, (u32)J_S420_P2);
    exact((u8*)"4:4:4", &J_S444[(i32)0], (i32)J_S444_LEN, (i32)J_S444_W, (i32)J_S444_H, (u32)J_S444_FNV, (u32)J_S444_P0, (u32)J_S444_P1, (u32)J_S444_P2);
    exact((u8*)"4:2:2", &J_S422[(i32)0], (i32)J_S422_LEN, (i32)J_S422_W, (i32)J_S422_H, (u32)J_S422_FNV, (u32)J_S422_P0, (u32)J_S422_P1, (u32)J_S422_P2);
    exact((u8*)"greyscale", &J_GREY[(i32)0], (i32)J_GREY_LEN, (i32)J_GREY_W, (i32)J_GREY_H, (u32)J_GREY_FNV, (u32)J_GREY_P0, (u32)J_GREY_P1, (u32)J_GREY_P2);
    exact((u8*)"restart intervals", &J_RST[(i32)0], (i32)J_RST_LEN, (i32)J_RST_W, (i32)J_RST_H, (u32)J_RST_FNV, (u32)J_RST_P0, (u32)J_RST_P1, (u32)J_RST_P2);
    exact((u8*)"three sequential scans", &J_SEQ[(i32)0], (i32)J_SEQ_LEN, (i32)J_SEQ_W, (i32)J_SEQ_H, (u32)J_SEQ_FNV, (u32)J_SEQ_P0, (u32)J_SEQ_P1, (u32)J_SEQ_P2);
    ck(UXJpeg.decode(&J_PROG[(i32)0], (i32)J_PROG_LEN) == (UXImage*)0, "a progressive JPEG is refused");
    ck(UXJpeg.decode(&J_S420[(i32)0], (i32)J_S420_LEN / (i32)2) == (UXImage*)0, "a truncated JPEG is refused");
    ck(UXJpeg.decode(&J_S420[(i32)2], (i32)J_S420_LEN - (i32)2) == (UXImage*)0, "data without the SOI marker is refused");
    ck(UXJpeg.decode(&J_S420[(i32)0], (i32)0) == (UXImage*)0, "an empty buffer is refused");
    if (gFails == 0)
        {
        Stdio.printf("PASS: UXJpeg decodes six baseline variants exactly as libjpeg does, and refuses four it should\n");
        }
    else
        {
        Stdio.printf("FAIL: %d\n", gFails);
        }
    }
