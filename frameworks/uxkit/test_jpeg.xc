// test_jpeg.xc — the JPEG decoder against libjpeg, byte for byte.
//
// The fixtures were made by libjpeg's cjpeg and are pasted, so the decoder is checked against bytes it
// did not make; the expected pixels are libjpeg's own decode of each one (djpeg -dct int -nosmooth,
// the configuration UXJpeg reproduces exactly), kept as an FNV-1a hash over every RGB byte plus three
// pixels to say where a mismatch is.  Between them: 4:2:0 with partial MCUs (an odd size), 4:4:4,
// 4:2:2, greyscale, restart intervals, a sequential image in three single-component scans -- and the
// refusals: progressive, truncated, not a JPEG, empty.
#import <Stdio.xc>
#import "UXJpeg.xc"

i32 gFails = 0;
void ck(bool ok, u8* what)
    {
    if (!ok)
        {
        Stdio.printf("  no: %s\n", what);
        gFails = gFails + 1;
        }
    }

